---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import WebRescue from "../components/WebRescue.astro";
import HiddenCost from "../components/HiddenCost.astro";
import Projects from "../components/Projects.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getFeaturedProjects, casePath } from "../data/projects";
import { faqItems } from "../data/engagement";
import { webRescueCopy } from "../data/web-rescue";
import { siteConfig } from "../data/site";

const featuredProjects = await getFeaturedProjects();
const personId = `${siteConfig.url}/#person`;
const featuredProjectsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Casos seleccionados de ${siteConfig.name}`,
  numberOfItems: featuredProjects.length,
  itemListElement: featuredProjects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "CreativeWork",
      name: project.title,
      url: new URL(casePath(project.slug), Astro.site).toString(),
      creator: { "@id": personId },
      isPartOf: { "@id": `${siteConfig.url}/#website` },
    },
  })),
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
   mainEntity: faqItems.map((item) => ({
     "@type": "Question",
     name: item.q,
     acceptedAnswer: { "@type": "Answer", text: item.a },
   })),
};

// Productized review/repair offer shown in the Home "Revisión web" block.
// Only offers with a fixed public amount become schema; larger repairs are
// quoted after the review and are not published as a price.
const rescueSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.url}/#revision-web`,
  name: "Revisión y reparación de webs",
  serviceType: "Revisión y reparación de webs existentes",
  description: webRescueCopy.lead,
  url: `${siteConfig.url}/#revision-web`,
  provider: { "@id": personId },
  areaServed: [
    { "@type": "City", name: siteConfig.location.city },
    { "@type": "Country", name: "España" },
  ],
  offers: webRescueCopy.prices
    .filter((price) => typeof price.amount === "number")
    .map((price) =>
      price.from
        ? {
            "@type": "Offer",
            name: price.title,
            priceCurrency: "EUR",
            priceSpecification: {
              "@type": "PriceSpecification",
              minPrice: price.amount,
              priceCurrency: "EUR",
            },
          }
        : {
            "@type": "Offer",
            name: price.title,
            priceCurrency: "EUR",
            price: price.amount,
          },
    ),
};
---

<MainLayout
  title="Desarrollo web en Granada, ecommerce y B2B | FRN.Q"
  description="Estudio independiente en Granada. Tiendas online, portales B2B, sistemas y webs profesionales; también reparo y mejoro webs existentes."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(featuredProjectsSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(rescueSchema)}
    slot="head"
  />

  <Header />
  <main id="main-content">
    <Hero />
    <Services />
    <WebRescue />
    <HiddenCost />
    <Projects />
    <About />
    <Contact />
  </main>
  <Footer />
</MainLayout>
