---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import HiddenCost from "../components/HiddenCost.astro";
import Projects from "../components/Projects.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getFeaturedProjects, casePath } from "../data/projects";
import { faqItems } from "../data/engagement";
import { siteConfig } from "../data/site";

const featuredProjects = await getFeaturedProjects();
const personId = `${siteConfig.url}/#person`;
const featuredProjectsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Casos seleccionados de ${siteConfig.name}`,
  numberOfItems: featuredProjects.length,
  itemListElement: featuredProjects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "CreativeWork",
      name: project.title,
      url: new URL(casePath(project.slug), Astro.site).toString(),
      creator: { "@id": personId },
    },
  })),
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
   mainEntity: faqItems.map((item) => ({
     "@type": "Question",
     name: item.q,
     acceptedAnswer: { "@type": "Answer", text: item.a },
   })),
};
---

<MainLayout
  title="Soluciones digitales para empresas | FRN.Q"
  description={siteConfig.description}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(featuredProjectsSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />

  <Header />
  <main id="main-content">
    <Hero />
    <Services />
    <HiddenCost />
    <Projects />
    <About />
    <Contact />
  </main>
  <Footer />
</MainLayout>
