---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import HiddenCost from '../components/HiddenCost.astro';
import Projects from '../components/Projects.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout 
  title="FRN.Q — Desarrollo Web Premium de Alto Rendimiento | Sin Plantillas"
  description="Desarrollo de infraestructuras digitales premium para empresas que buscan diferenciación. 100% código a medida, rendimiento garantizado, sin plantillas. Francisco Muñoz - FRN.Q Studio Granada."
>
  <Header />
  <main id="main-content">
    <Hero />
    <Services />
    <HiddenCost />
    <Projects />
    <About />
    <Contact />
  </main>
  <Footer />
</MainLayout>
