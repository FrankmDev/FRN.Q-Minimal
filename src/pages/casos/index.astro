---
import { Image } from "astro:assets";
import { siteConfig } from "../../data/site";
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
  getPublishedProjects,
  categoryLabels,
  statusLabels,
  caseGroups,
  casePath,
  type Project,
} from "../../data/projects";

const projects = await getPublishedProjects();

/**
 * Cases grouped by commercial type, in service-hierarchy order. Empty groups
 * are dropped, so the archive never shows an empty shelf.
 */
const groups = caseGroups
  .map((group) => ({
    ...group,
    items: projects.filter((project) =>
      group.categories.includes(project.category),
    ),
  }))
  .filter((group) => group.items.length > 0);

/** KingBelt evidences ecommerce and Emilio Faraoni B2B: mark both as references. */
function referenceLabel(project: Project): string | undefined {
  if (project.serviceArea === "ecommerce") return "Referencia ecommerce";
  if (project.serviceArea === "b2b") return "Referencia B2B";
  return undefined;
}

function plural(count: number): string {
  return `${count} ${count === 1 ? "caso" : "casos"}`;
}

/** Continuous archive numbering, so card badges never clash with group numbers. */
const indexBySlug = new Map(
  projects.map((project, index) => [project.slug, index + 1]),
);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
   name: `Casos de ${siteConfig.name}`,
  numberOfItems: projects.length,
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: project.title,
    url: new URL(casePath(project.slug), Astro.site).toString(),
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
     { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 2,
      name: "Casos",
       item: new URL("/casos/", Astro.site).toString(),
    },
  ],
};
---

<MainLayout
   title={`Casos de proyectos digitales | ${siteConfig.name}`}
    description="Proyectos publicados de FRN.Q con su contexto, alcance y decisiones. Consulta el trabajo realizado para cada cliente y sector."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(itemListSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
    slot="head"
  />

  <Header />

  <main id="main-content" class="cases-index">
    <section class="cases-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Casos</span>
        </nav>
        <p class="section-tag section-tag--inline">Trabajo seleccionado</p>
        <h1 class="title">
          Casos<br />
          <span class="title-strong title-mark">reales.</span>
        </h1>
        <p class="intro">
          Contexto, problema, solución y decisiones detrás de cada proyecto,
          agrupados por el tipo de solución que demuestran.
        </p>
      </div>
    </section>

    <nav class="type-index" aria-label="Índice por tipo de proyecto">
      <div class="cases-shell">
        <p class="type-index-label">Tipos</p>
        <ul>
          {
            groups.map((group, index) => (
              <li>
                <a
                  href={`#tipo-${group.id}`}
                  class:list={[
                    "type-entry",
                    group.emphasis && `type-entry--${group.emphasis}`,
                  ]}
                >
                  <span class="type-num" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="type-label">{group.label}</span>
                  <span class="type-count">{plural(group.items.length)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <section class="cases-list" aria-label="Lista de casos">
      <div class="cases-shell">
        {
          groups.map((group, groupIndex) => (
            <section
              class="case-group"
              id={`tipo-${group.id}`}
              aria-labelledby={`tipo-${group.id}-title`}
            >
              <header
                class:list={[
                  "group-head",
                  group.emphasis && `group-head--${group.emphasis}`,
                ]}
              >
                <span class="group-num" aria-hidden="true">
                  {String(groupIndex + 1).padStart(2, "0")}
                </span>
                <h2 id={`tipo-${group.id}-title`}>{group.label}</h2>
                <p class="group-short">{group.short}</p>
                <span class="group-count">{plural(group.items.length)}</span>
              </header>

              <ul class="grid">
                {group.items.map((project: Project, i) => (
                  <li>
                    <a
                      class:list={[
                        "card",
                        project.serviceArea === "ecommerce" && "card--primary",
                        project.serviceArea === "b2b" && "card--secondary",
                      ]}
                      href={casePath(project.slug)}
                      data-track="case_click"
                      data-track-location="casos"
                      data-track-slug={project.slug}
                    >
                      <div class="card-media">
                        <Image
                          src={project.cover.src}
                          alt={project.cover.alt}
                          widths={[480, 800, 1200, 1600]}
                          sizes="(max-width: 768px) 100vw, 50vw"
                          format="avif"
                          quality={88}
                          loading={i < 2 ? "eager" : "lazy"}
                        />
                        <span class="card-index" aria-hidden="true">
                          {String(indexBySlug.get(project.slug) ?? i + 1).padStart(2, "0")}
                        </span>
                        {referenceLabel(project) && (
                          <span class="card-badge">{referenceLabel(project)}</span>
                        )}
                      </div>
                      <div class="card-body">
                        <p class="card-meta">
                          <span>{categoryLabels[project.category]}</span>
                          <span class="dot" aria-hidden="true">·</span>
                          <span>{project.sector}</span>
                          <span class="dot" aria-hidden="true">·</span>
                          <span>{project.year}</span>
                        </p>
                        <h3 class="card-title">{project.title}</h3>
                        <p class="card-value">{project.tagline}</p>
                        <span class="card-status">
                          <span class="status-dot" aria-hidden="true" />
                          {statusLabels[project.status]}
                          <span class="card-arrow" aria-hidden="true">→</span>
                        </span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }

        <div class="cases-cta">
          <p>¿Quieres un caso aplicado a tu negocio?</p>
          <a
            class="cta"
            href="/#contacto"
            data-track="cta_click"
            data-track-location="casos"
            data-track-label="Hablemos"
          >
            <span>Hablemos</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>

<style>
  .cases-index {
    padding-top: 120px;
  }

  .cases-hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
    border-bottom: 4px solid var(--border);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2xl);
  }

  .crumbs a {
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .crumbs a:hover {
    opacity: 1;
  }

  .crumbs span {
    opacity: 0.4;
  }

  .crumbs [aria-current="page"],
  .crumbs span:last-child {
    opacity: 1;
  }

  .section-tag--inline {
    margin-bottom: var(--space-lg);
  }

  .title {
    font-size: clamp(2.5rem, 10vw, 8rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .title-strong {
    font-weight: inherit;
  }

  .intro {
    max-width: 68ch;
    margin-top: var(--space-xl);
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .cases-list {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }

  /* Wider than the standard content column so case cards fill more screen. */
  .cases-shell {
    width: 100%;
    max-width: 96rem;
    margin-inline: auto;
    padding-inline: var(--layout-gutter);
  }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(var(--space-lg), 2.2vw, var(--space-2xl));
    }
  }

  /* Type index: a static, industrial list so the archive can be scanned by
     kind of project without client-side filtering. */
  .type-index {
    padding: var(--space-2xl) 0;
    border-bottom: 2px dashed var(--border-light);
    scroll-margin-top: calc(var(--layout-header-height) + var(--space-lg));
  }

  .type-index-label {
    margin-bottom: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .type-index ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .type-entry {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    min-height: 3.25rem;
    padding: var(--space-md);
    border: 2px solid var(--border);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .type-entry--primary {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .type-entry--secondary {
    background: var(--text);
    color: var(--bg);
  }

  .type-entry:hover {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--border);
  }

  .type-entry:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .type-num {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    opacity: 0.6;
  }

  .type-label {
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .type-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
    white-space: nowrap;
  }

  /* Grouped archive by commercial type. */
  .case-group + .case-group {
    margin-top: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .case-group {
    scroll-margin-top: calc(var(--layout-header-height) + var(--space-lg));
  }

  .group-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs) var(--space-lg);
    margin-bottom: clamp(var(--space-lg), 3vw, var(--space-2xl));
    padding-top: var(--space-md);
    border-top: 3px solid var(--border);
  }

  /* Priority 1 keeps the accent plate, priority 2 the inverted ink plate,
     mirroring the service hierarchy. */
  .group-head--primary,
  .group-head--secondary {
    padding: var(--space-lg);
    border: 3px solid var(--border);
  }

  .group-head--primary {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .group-head--secondary {
    background: var(--text);
    color: var(--bg);
  }

  .group-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.55;
  }

  .group-head h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3.6vw, 2.75rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .group-short {
    grid-column: 2 / -1;
    max-width: 54ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .group-head--primary .group-short,
  .group-head--secondary .group-short {
    color: inherit;
    opacity: 0.82;
  }

  .group-count {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.65;
    white-space: nowrap;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 3px solid var(--border);
    background: var(--bg);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .card:hover {
    transform: translate(-6px, -6px);
    box-shadow: 12px 12px 0 var(--border);
  }

  .card-media {
    position: relative;
    border-bottom: 3px solid var(--border);
    background: var(--bg-alt);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover .card-media :global(img) {
    transform: scale(1.04);
  }

  .card-index {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    padding: 0.25rem 0.5rem;
    background: var(--bg);
    border: 2px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Reference marker on the two flagship cases: KingBelt (ecommerce, accent)
     and Emilio Faraoni (B2B, inverted ink). */
  .card-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    max-width: calc(100% - var(--space-2xl));
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card--primary .card-badge {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .card--secondary .card-badge {
    background: var(--text);
    color: var(--bg);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: clamp(var(--space-lg), 2vw, var(--space-2xl));
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.65;
  }

  .dot {
    opacity: 0.5;
  }

  .card-title {
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .card-value {
    color: var(--text-muted);
    line-height: 1.5;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
  }

  .card-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .card-arrow {
    margin-left: auto;
    font-size: 1.125rem;
    transition: transform var(--transition-base);
  }

  .card:hover .card-arrow {
    transform: translateX(6px);
  }

  .cases-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-top: var(--space-4xl);
    padding-top: var(--space-2xl);
    border-top: 4px solid var(--border);
  }

  .cases-cta p {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-2xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--text);
    color: var(--bg);
    border: 3px solid var(--text);
    box-shadow: 8px 8px 0 var(--accent);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-media :global(img),
    .card-arrow,
    .type-entry,
    .cta {
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .group-head {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .group-count {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
