---
import { Image, getImage } from "astro:assets";
import { siteConfig } from "../../data/site";
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
  getPublishedProjects,
  categoryLabels,
  statusLabels,
  casePath,
  type Project,
} from "../../data/projects";
import {
  getServiceForSolution,
  getSolutionForCase,
  solutionContactTypes,
  solutionPath,
} from "../../data/solutions";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next }: Props = Astro.props;
const categoryLabel = categoryLabels[project.category];
const statusLabel = statusLabels[project.status];
const canonical = new URL(casePath(project.slug), Astro.site).toString();
/**
 * Every published case links back to the commercial solution it evidences:
 * `serviceArea` when the case proves ecommerce, B2B or systems, otherwise the
 * case category selects the web/product solution it demonstrates.
 */
const caseSolution = getSolutionForCase(project);
const caseService = caseSolution ? getServiceForSolution(caseSolution) : undefined;
const caseContactType = caseSolution
  ? solutionContactTypes[caseSolution.id]
  : undefined;
const personId = `${siteConfig.url}/#person`;

const og = await getImage({
  src: project.cover.src,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 80,
});
const ogImage = new URL(og.src, Astro.site).toString();

const techLabel = project.technologies.join(" · ");

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${canonical}#project`,
  name: project.title,
  headline: project.tagline,
  description: project.seo.description,
  url: canonical,
  mainEntityOfPage: canonical,
  isPartOf: { "@id": `${siteConfig.url}/#website` },
  inLanguage: "es-ES",
  image: ogImage,
  keywords: project.seo.keywords.join(", "),
  about: project.sector,
  author: {
    "@id": personId,
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
     { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
    {
      "@type": "ListItem",
      position: 2,
      name: "Casos",
       item: new URL("/casos/", Astro.site).toString(),
    },
    { "@type": "ListItem", position: 3, name: project.title, item: canonical },
  ],
};

const facts = [
  { label: "Cliente", value: project.client },
  { label: "Sector", value: project.sector },
  { label: "Año", value: project.year },
  { label: "Estado", value: statusLabel },
];
---

<MainLayout
  title={project.seo.title}
  description={project.seo.description}
  ogImage={ogImage}
  ogImageAlt={project.cover.alt}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(caseSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
    slot="head"
  />

  <Header />

  <main id="main-content" class="case">
    <article>
      <!-- Hero -->
      <header class="case-hero">
        <div class="container">
          <nav class="case-breadcrumb" aria-label="Ruta de navegación">
            <a href="/">Inicio</a>
            <span aria-hidden="true">/</span>
            <a href="/casos/">Casos</a>
          </nav>

          <p class="case-eyebrow">
            <span>{categoryLabel}</span>
            <span class="eyebrow-sep" aria-hidden="true">·</span>
            <span>{project.sector}</span>
            <span class="eyebrow-sep" aria-hidden="true">·</span>
            <span>{project.year}</span>
          </p>

          <h1 class="case-title">{project.title}</h1>
          <p class="case-tagline">{project.tagline}</p>

          <div class="case-hero-actions">
            {
              project.url && (
                <a
                  class="case-link"
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{project.urlLabel}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )
            }
            <span class="case-status">
              <span class="status-dot" aria-hidden="true" />
              {statusLabel}
            </span>
          </div>
        </div>

        <div class="container">
          <figure class="case-cover">
            <Image
              src={project.cover.src}
              alt={project.cover.alt}
              widths={[640, 1024, 1600, 2000]}
              sizes="(max-width: 768px) 100vw, 1280px"
              format="avif"
              quality={90}
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </header>

      <!-- At a glance -->
      <section class="case-facts" aria-label="Ficha del caso">
        <div class="container">
          <dl class="facts-grid">
            {
              facts.map((fact) => (
                <div class="fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
          <ul class="scope-list" aria-label="Alcance del proyecto">
            {
              project.scope.map((item: string) => (
                <li>
                  <span aria-hidden="true">+</span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Business reading: the whole case in one compact block, before the
           long technical narrative. -->
      <section class="case-brief reveal" aria-labelledby="case-brief-title">
        <div class="container">
          <div class="brief-panel">
            <header class="section-head brief-head">
              <h2 id="case-brief-title">Lectura de negocio</h2>
            </header>
            <dl class="brief-grid">
              <div class="brief-item">
                <dt>Negocio</dt>
                <dd>{project.summary.business}</dd>
              </div>
              <div class="brief-item">
                <dt>Reto</dt>
                <dd>{project.summary.challenge}</dd>
              </div>
              <div class="brief-item">
                <dt>Alcance ejecutado</dt>
                <dd>{project.summary.delivered}</dd>
              </div>
              <div class="brief-item">
                <dt>Resultado verificable</dt>
                <dd>{project.summary.outcome}</dd>
              </div>
            </dl>
            <p class="brief-decision">
              <span class="brief-decision-label">Decisión clave</span>
              <span class="brief-decision-text">{project.summary.decision}</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Business value first -->
      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">01</span>
            <h2>Contexto</h2>
          </div>
          <p class="lede">{project.context}</p>
        </div>
      </section>

      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">02</span>
            <h2>El problema</h2>
          </div>
          <p class="lede">{project.problem}</p>
        </div>
      </section>

      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">03</span>
            <h2>El objetivo</h2>
          </div>
          <p class="lede">{project.objective}</p>
        </div>
      </section>

      <!-- Implementation -->
      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">04</span>
            <h2>La solución</h2>
          </div>
          <p class="lede">{project.solution}</p>
        </div>
      </section>

      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">05</span>
            <h2>Funcionalidades</h2>
          </div>
          <div class="feature-grid">
            {
              project.features.map((feature: { title: string; description: string }) => (
                <article class="feature">
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">06</span>
            <h2>Decisiones</h2>
          </div>
          <ul class="decision-list">
            {
              project.decisions.map((decision: { title: string; description: string }, i: number) => (
                <li class="decision">
                  <span class="decision-num" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3>{decision.title}</h3>
                    <p>{decision.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Outcome -->
      <section class="case-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">07</span>
            <h2>Resultado observable</h2>
          </div>
          <p class="lede">{project.result}</p>

          {
            project.metrics && project.metrics.length > 0 && (
              <ul class="metrics" aria-label="Métricas verificadas">
                {project.metrics.map((metric: { value: string; label: string; note?: string }) => (
                  <li class="metric">
                    <span class="metric-value">{metric.value}</span>
                    <span class="metric-label">{metric.label}</span>
                    {metric.note && <span class="metric-note">{metric.note}</span>}
                  </li>
                ))}
              </ul>
            )
          }

          <p class="tech-note">
            <span class="tech-note-label">Tecnologías</span>
            <span>{techLabel}</span>
          </p>
        </div>
      </section>

      <!-- Gallery -->
      <section class="case-section case-gallery-section reveal">
        <div class="container">
          <div class="section-head">
            <span class="section-num" aria-hidden="true">08</span>
            <h2>En detalle</h2>
          </div>
          <div class="gallery">
            {
               project.images.map((image, i) => (
                <figure class:list={["gallery-item", { "gallery-item-wide": i === 0 }]}>
                  <Image
                    src={image.src}
                    alt={image.alt}
                    widths={[480, 800, 1200, 1600, 2000]}
                    sizes={
                      i === 0
                        ? "(max-width: 768px) 100vw, 1280px"
                        : "(max-width: 768px) 100vw, (min-width: 1600px) 800px, 50vw"
                    }
                    format="avif"
                    quality={88}
                    loading="lazy"
                  />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- The commercial solution this case evidences, with the matching CTA. -->
      {
        caseSolution && caseService && (
          <section class="case-solution" aria-labelledby="case-solution-title">
            <div class="container">
              <div
                class:list={[
                  "solution-panel",
                  caseSolution.id === "ecommerce" && "solution-panel--primary",
                  caseSolution.id === "b2b" && "solution-panel--secondary",
                ]}
              >
                <p class="solution-kicker">Solución aplicada</p>
                <h2 id="case-solution-title">{caseService.title}</h2>
                <p class="solution-result">{caseService.short}</p>
                <div class="solution-actions">
                  <a
                    class="solution-cta"
                    href={caseContactType ? `/?tipo=${caseContactType}#contacto` : "/#contacto"}
                    data-contact-type={caseContactType}
                    data-track="cta_click"
                    data-track-location="case_solution"
                    data-track-slug={project.slug}
                  >
                    <span>Quiero algo así</span>
                    <span aria-hidden="true">→</span>
                  </a>
                  <a
                    class="solution-link"
                    href={solutionPath(caseSolution.slug)}
                    data-track="cta_click"
                    data-track-location="case_solution"
                    data-track-label={caseService.title}
                    data-track-slug={project.slug}
                  >
                    <span>Ver la solución de {caseService.title}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </section>
        )
      }

      <!-- Next + back -->
      <section class="case-next">
        <div class="container">
          <a
            class="next-case"
            href={casePath(next.slug)}
            aria-label={`Siguiente caso: ${next.title}`}
            data-track="case_click"
            data-track-location="case"
            data-track-slug={next.slug}
          >
            <span class="next-label">Siguiente caso</span>
            <span class="next-title">{next.title}</span>
            <span class="next-arrow" aria-hidden="true">→</span>
          </a>
          <a class="back-link" href="/casos/">← Volver a todos los casos</a>
          <a class="back-link" href="/soporte/">Soporte y mantenimiento</a>
          <a class="back-link" href="/#servicios">Ver todas las soluciones</a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</MainLayout>

<style>
  .case {
    padding-top: 120px;
  }

  /* Hero */
  .case-hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
    border-bottom: 4px solid var(--border);
  }

  .case-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2xl);
  }

  .case-breadcrumb a {
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .case-breadcrumb a:hover {
    opacity: 1;
  }

  .case-breadcrumb span {
    opacity: 0.4;
  }

  .case-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-lg);
    opacity: 0.75;
  }

  .eyebrow-sep {
    opacity: 0.4;
  }

  .case-title {
    font-size: clamp(2.5rem, 9vw, 7rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .case-tagline {
    max-width: 55ch;
    margin-top: var(--space-lg);
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .case-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--text);
    color: var(--bg);
    border: 3px solid var(--text);
    box-shadow: 8px 8px 0 var(--accent);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .case-link:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--accent);
  }

  .case-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.75;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .case-cover {
    margin-top: var(--space-3xl);
    border: 4px solid var(--border);
    box-shadow: 12px 12px 0 var(--border);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-alt);
  }

  .case-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Facts */
  .case-facts {
    padding: var(--space-3xl) 0;
    border-bottom: 4px solid var(--border);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .facts-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.55;
    margin-bottom: var(--space-xs);
  }

  .fact dd {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .scope-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
  }

  .scope-list li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border: 2px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .scope-list li span {
    font-weight: 700;
    opacity: 0.5;
  }

  /* Compact business reading — the case at a glance, before the long
     narrative. Shares the ruled/dashed language and adds one hard frame. */
  .case-brief {
    padding: var(--space-2xl) 0;
    border-bottom: 2px dashed var(--border-light);
  }

  .brief-panel {
    padding: clamp(var(--space-lg), 3.5vw, var(--space-2xl));
    border: 3px solid var(--border);
    border-top: 4px solid var(--accent);
    background: var(--bg-alt);
    box-shadow: 8px 8px 0 var(--border);
  }

  .brief-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-lg) clamp(var(--space-lg), 3vw, var(--space-2xl));
    margin: 0;
  }

  .brief-item {
    padding-top: var(--space-md);
    border-top: 2px solid var(--border);
  }

  .brief-item dt {
    margin-bottom: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .brief-item dd {
    max-width: 36ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .brief-decision {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm) var(--space-md);
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-md);
    border-top: 3px solid var(--border);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .brief-decision-label {
    flex: 0 0 auto;
    padding: 0.25rem 0.5rem;
    background: var(--accent);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brief-decision-text {
    max-width: 62ch;
    font-weight: 600;
  }

  /* Commercial solution this case evidences. Priority 1 (ecommerce) gets the
     accent plate, priority 2 (B2B) the inverted ink plate; the rest stay on
     paper. */
  .case-solution {
    padding: var(--space-2xl) 0 0;
  }

  .solution-panel {
    --panel-focus: var(--text);
    padding: clamp(var(--space-lg), 3.5vw, var(--space-2xl));
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: 8px 8px 0 var(--border);
  }

  .solution-panel--primary {
    --panel-focus: var(--text-on-accent);
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .solution-panel--secondary {
    --panel-focus: var(--bg);
    background: var(--text);
    color: var(--bg);
  }

  .solution-kicker {
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .solution-panel h2 {
    max-width: 22ch;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .solution-result {
    max-width: 58ch;
    margin-top: var(--space-md);
    font-size: clamp(1rem, 1.7vw, 1.125rem);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .solution-panel--primary .solution-result,
  .solution-panel--secondary .solution-result {
    color: inherit;
    opacity: 0.82;
  }

  .solution-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-xl);
  }

  .solution-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    border: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 8px 8px 0 var(--accent);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .solution-panel--secondary .solution-cta {
    background: var(--bg);
    color: var(--text);
  }

  .solution-cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--accent);
  }

  .solution-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .solution-cta:focus-visible,
  .solution-link:focus-visible {
    outline: 3px solid var(--panel-focus);
    outline-offset: 4px;
  }

  .solution-link:focus-visible {
    outline-color: currentColor;
  }

  /* Sections */
  .case-section {
    padding: var(--space-3xl) 0;
    border-bottom: 2px dashed var(--border-light);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

