---
import CustomCursor from "../components/CustomCursor.astro";
import RevealObserver from "../components/RevealObserver.astro";
import SEOHead from "../components/SEOHead.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { siteConfig } from "../data/site";
import { getPublishedProjects, casePath } from "../data/projects";
import { solutionPages, solutionPath } from "../data/solutions";
import { supportPath } from "../data/support";
import { getGuides, guidePath } from "../data/guias";
import { webRescuePage } from "../data/web-rescue";
import { isGa4MeasurementId } from "../scripts/analytics";
import "../styles/app.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  ogImageAlt,
  noindex = false,
  nofollow = false,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
   Astro.site || siteConfig.url,
);
// Build-only route allowlist: the browser never imports case or solution copy.
const trackingPages = [
  "/", "/casos/", "/precios/", "/guias/", "/colaboraciones/agencias/", "/legal/", "/legal/privacidad/", "/404/",
  ...solutionPages.map((solution) => solutionPath(solution.slug)),
  webRescuePage.path,
  supportPath,
  ...(await getPublishedProjects()).map((project) => casePath(project.slug)),
  ...(await getGuides()).map((guide) => guidePath(guide.slug)),
];

// GA4 stays completely off unless a valid Measurement ID arrives from the
// environment. No identifier is hard-coded and nothing is loaded before the
// visitor consents (see `scripts/analytics.ts` → `loadAnalyticsProvider`).
const ga4MeasurementId = (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? "").trim();
const ga4Ready = isGa4MeasurementId(ga4MeasurementId);
---

<!doctype html>
<html lang={siteConfig.lang} data-theme="light" data-track-pages={trackingPages.join("|")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SEOHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      noindex={noindex}
      nofollow={nofollow}
    />
    <script is:inline>
      (() => {
        let savedTheme = "light";

        try {
          savedTheme = localStorage.getItem("theme") === "dark" ? "dark" : "light";
        } catch {
          // Storage can be unavailable; keep the light default.
        }

        const theme = savedTheme;
        const root = document.documentElement;
        root.setAttribute("data-theme", theme);
        root.style.colorScheme = theme;

        const themeColor = document.querySelector('meta[name="theme-color"]');
        themeColor?.setAttribute("content", theme === "dark" ? "#171715" : "#f4f3ef");
      })();
    </script>
    {ga4Ready && (
      <script is:inline define:vars={{ ga4MeasurementId }}>
        window.__FRNQ_ANALYTICS__ = {
          enabled: true,
          provider: "gtag",
          measurementId: ga4MeasurementId,
          requireConsent: true,
        };
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <slot />
    {ga4Ready && <AnalyticsConsent />}
    <CustomCursor />
    <RevealObserver />
    <script>
      import { initTracking } from "../scripts/analytics";
      initTracking();
    </script>
  </body>
</html>
