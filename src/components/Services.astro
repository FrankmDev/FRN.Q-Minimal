---
import { serviceAreas, servicesCopy, type ServiceArea } from "../data/services";
---

<section class="services" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <header class="services-header reveal">
      <div class="section-label mono">
        <span aria-hidden="true"></span>
        {servicesCopy.label}
      </div>
      <h2 id="services-title">Cuatro áreas.<br /><span>Un mismo negocio.</span></h2>
    </header>

    <ul class="solutions-grid reveal" role="list" id="services-grid">
      {
        serviceAreas.map((service: ServiceArea, index) => (
          <li
            class:list={["service-card", `sol-${index}`]}
            id={`sol-${service.id}`}
            aria-labelledby={`sol-${service.id}-title`}
          >
            <span class="card-number mono" aria-hidden="true">{service.num}</span>
            <div class="card-content">
              <h3 class="card-title" id={`sol-${service.id}-title`}>
                {service.title}
              </h3>
              <p class="card-desc">{service.short}</p>
            </div>
            <span class="card-corner" aria-hidden="true">↗</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
    scroll-margin-top: var(--layout-header-height);
  }

  .services::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .services-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 0 0 auto;
    margin-bottom: 0.25em;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-label span {
    width: 1.75rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    background: var(--accent);
  }

  .services-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5.7vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .services-header h2 span { color: var(--text-muted); }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-md), 2.5vw, var(--space-xl));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-card {
    --card-ink: var(--text);
    --card-paper: var(--bg);
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(17rem, 28vw, 23rem);
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(var(--space-lg), 3.2vw, var(--space-2xl));
    border: 3px solid var(--border);
    background: var(--card-paper);
    color: var(--card-ink);
    transition: transform 280ms var(--motion-ease-out), box-shadow 280ms var(--motion-ease-out), background-color 280ms var(--motion-ease-out), color 280ms var(--motion-ease-out);
  }

  .service-card::before {
    position: absolute;
    z-index: -1;
    right: -0.03em;
    bottom: -0.31em;
    content: "";
    color: color-mix(in srgb, var(--card-ink) 7%, transparent);
    font: 800 clamp(10rem, 21vw, 18rem) / 0.8 var(--font-mono);
    letter-spacing: -0.12em;
    pointer-events: none;
  }

  .sol-0::before { content: "01"; }
  .sol-1::before { content: "02"; }
  .sol-2::before { content: "03"; }
  .sol-3::before { content: "04"; }

  .sol-1 { --card-ink: var(--bg); --card-paper: var(--text); }
  .sol-2 { --card-paper: var(--accent); }

  .card-number {
    width: fit-content;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.1em;
    color: transparent;
    -webkit-text-stroke: 2px var(--card-ink);
    opacity: 0.8;
    transition: transform 350ms var(--motion-ease-out), color 350ms ease;
  }

  .card-content {
    position: relative;
    z-index: 1;
    max-width: 33rem;
    padding-right: var(--space-2xl);
  }

  .card-title {
    max-width: 17ch;
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.4rem, 2.9vw, 2.5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.05em;
    transition: transform 350ms var(--motion-ease-out);
  }

  .card-desc {
    max-width: 42ch;
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    font-size: clamp(0.875rem, 1.25vw, 1rem);
    line-height: 1.5;
    opacity: 0.76;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-corner {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    font-size: 1.125rem;
    transition: transform 280ms var(--motion-ease-out), background-color 280ms ease;
  }

  .service-card:hover,
  .service-card:focus-within {
    transform: translate(-6px, -6px);
    box-shadow: 10px 10px 0 var(--border);
  }

  .service-card:hover .card-number,
  .service-card:focus-within .card-number {
    transform: translate(6px, -3px) rotate(-4deg);
    color: var(--accent);
    opacity: 1;
  }

  .service-card:hover .card-title,
  .service-card:focus-within .card-title { transform: translateX(4px); }

  .service-card:hover .card-corner,
  .service-card:focus-within .card-corner {
    transform: translate(3px, -3px);
    background: var(--accent);
    color: var(--text);
  }

  @media (max-width: 760px) {
    .services-header { display: block; }
    .services-header h2 { margin-top: var(--space-lg); text-align: left; }
    .service-card { min-height: 16rem; }
    .card-content { padding-right: 0; }
    .card-number { font-size: clamp(3.25rem, 11vw, 5rem); }
  }

  @media (max-width: 560px) {
    .solutions-grid { grid-template-columns: 1fr; gap: var(--space-md); }
    .service-card { min-height: 13.5rem; padding: var(--space-lg); }
    .service-card::before { font-size: 12rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card, .card-number, .card-title, .card-corner { transition: none; }
  }
</style>
