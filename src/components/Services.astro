---
import { serviceAreas, servicesCopy, type ServiceArea } from "../data/services";
import { getSolutionForService, solutionPath } from "../data/solutions";

// The first area leads the section as the priority accent feature plate; the
// rest follow as offset-shadow paper plates on a three-column grid. Same data,
// same devices, deliberate scale shift.
const [feature, ...rest] = serviceAreas;

const hrefFor = (id: string) => {
  const solution = getSolutionForService(id);
  return solution ? solutionPath(solution.slug) : "/#contacto";
};
---

<section class="services" id="servicios" aria-labelledby="services-title">
  <span class="section-tag">{servicesCopy.label}</span>
  <div class="container">
    <header class="services-header reveal">
      <h2 id="services-title" class="section-title">
        {servicesCopy.titleLine}<br /><span class="title-mark">{servicesCopy.titleHighlight}</span>
      </h2>
      <p class="services-lead">{servicesCopy.lead}</p>
    </header>

    <article
      class="service-feature reveal"
      id={`sol-${feature.id}`}
      aria-labelledby={`sol-${feature.id}-title`}
    >
      <span class="feature-num mono" aria-hidden="true">{feature.num}</span>
      <div class="feature-body">
        <span class="feature-audience mono">{feature.audience}</span>
        <h3 class="feature-title" id={`sol-${feature.id}-title`}>{feature.title}</h3>
        <p class="feature-problem">{feature.problem}</p>
        <p class="feature-desc">{feature.short}</p>
        <a
          class="feature-link"
          href={hrefFor(feature.id)}
          aria-label={`${feature.linkLabel}: ${feature.title}`}
          data-track="cta_click"
          data-track-location="home_services"
          data-track-slug={feature.id}
        >
          {feature.linkLabel}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <span class="feature-corner" aria-hidden="true">↗</span>
    </article>

    <ul class="solutions-list reveal" role="list" aria-label="Otras áreas de servicio">
      {
        rest.map((service: ServiceArea) => (
          <li
            class="service-row"
            id={`sol-${service.id}`}
            aria-labelledby={`sol-${service.id}-title`}
          >
            <span class="row-num mono" aria-hidden="true">{service.num}</span>
            <div class="row-head">
              <span class="row-audience mono">{service.audience}</span>
              <h3 class="row-title" id={`sol-${service.id}-title`}>{service.title}</h3>
            </div>
            <div class="row-copy">
              <p class="row-problem">{service.problem}</p>
              <p class="row-desc">{service.short}</p>
            </div>
            <a
              class="row-link"
              href={hrefFor(service.id)}
              aria-label={`${service.linkLabel}: ${service.title}`}
              data-track="cta_click"
              data-track-location="home_services"
              data-track-slug={service.id}
            >
              {service.linkLabel}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="services-footer">
      <p class="services-footer-note mono">¿Tu web o tu sistema ya está en marcha?</p>
      <div class="services-footer-links">
        <a class="services-support-link" href="/soporte/">
          Soporte y mantenimiento <span aria-hidden="true">→</span>
        </a>
        <a class="services-support-link" href="/precios/">
          Precios públicos <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
  }

  .services::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  /* Header metrics are shared with the other Home section headers: title
     capped at 4.5rem and lead at 26rem so the longest marked line still
     leaves the description enough room on wide viewports. */
  .services-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(var(--space-xl), 4vw, var(--space-3xl));
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .services-header h2 {
    order: 2;
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .services-lead {
    order: 1;
    max-width: 26rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    line-height: 1.55;
  }

  /* ---- Priority feature plate ---- */
  .service-feature {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1.58fr);
    align-items: start;
    gap: clamp(var(--space-lg), 4vw, var(--space-3xl));
    overflow: hidden;
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-3xl));
    padding: clamp(var(--space-xl), 4vw, var(--space-3xl));
    border: 3px solid var(--border);
    background: var(--accent);
    color: var(--text-on-accent);
    box-shadow: 12px 12px 0 var(--border);
    transition: transform var(--transition-card), box-shadow var(--transition-card-shadow);
  }

  .service-feature:hover {
    transform: translate(-6px, -6px);
    box-shadow: 16px 16px 0 var(--border);
  }

  .feature-num {
    font-size: clamp(4.5rem, 11vw, 9.5rem);
    font-weight: 800;
    line-height: 0.72;
    letter-spacing: -0.12em;
    opacity: 0.9;
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .feature-audience {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.66;
  }

  .feature-title {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .feature-problem {
    max-width: 40ch;
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .feature-desc {
    max-width: 46ch;
    margin: 0;
    font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
    line-height: 1.5;
    opacity: 0.82;
  }

  /* Card CTA: outlined control plate at rest, accent plate on hover. The
     highlighted site CTA (HABLEMOS) keeps the ink fill and accent shadow, so
     these stay clearly secondary. */
  .feature-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    align-self: stretch;
    max-width: 22rem;
    margin-top: var(--space-md);
    padding: 0.7rem var(--space-md);
    border: 2px solid currentColor;
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .feature-link span { transition: transform var(--transition-fast); }
  .feature-link:hover { background: var(--text-on-accent); color: var(--accent); }
  .feature-link:hover span { transform: translateX(4px); }
  .feature-link:focus-visible { outline: 3px solid currentColor; outline-offset: 4px; }

  .feature-corner {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    display: grid;
    width: 2.6rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    font-size: 1.125rem;
    transition: transform 280ms var(--motion-ease-out);
  }

  .service-feature:hover .feature-corner { transform: translate(3px, -3px); }

  /* ---- Commercial index plates ---- */
  .solutions-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-lg), 3vw, var(--space-2xl));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: clamp(var(--space-lg), 2.6vw, var(--space-xl));
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: 8px 8px 0 var(--border);
    transition: transform var(--transition-card), box-shadow var(--transition-card-shadow);
  }

  .service-row:hover,
  .service-row:focus-within {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--border);
  }

  /* Hover signature: the accent rule inks across the top edge, left to right. */
  .service-row::after {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
    content: "";
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .service-row:hover::after,
  .service-row:focus-within::after { transform: scaleX(1); }

  /* Numeral slot: signage mark, numeral and dashed rail, echoing the feature
     plate's numeral at a smaller scale. */
  .row-num {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .row-num::before {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    background: var(--accent);
    content: "";
  }

  .row-num::after {
    flex: 1 1 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 8px, transparent 8px 16px);
    opacity: 0.45;
    content: "";
  }

  .row-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .row-audience {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .row-title {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .row-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-light);
  }

  .row-problem {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .row-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .row-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    margin-top: auto;
    padding: 0.7rem var(--space-md);
    border: 2px solid var(--border);
    background: var(--bg-alt);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .row-link span { transition: transform var(--transition-fast); }

  .service-row:hover .row-link,
  .row-link:hover,
  .row-link:focus-visible {
    border-color: var(--text-on-accent);
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .service-row:hover .row-link span,
  .row-link:hover span,
  .row-link:focus-visible span { transform: translateX(4px); }

  .row-link:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }

  /* The three plates share one internal metric: numeral slot, kicker, a
     two-line title, a two-line problem, a two-line outcome and the CTA, so the
     rows align from card to card. */
  @media (min-width: 1025px) {
    .row-title { min-height: 1.96em; }
    .row-problem { min-height: 2.7em; }
    .row-desc { min-height: 3.1em; }
  }

  .services-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    margin-top: clamp(var(--space-xl), 4vw, var(--space-2xl));
    padding-top: var(--space-lg);
    border-top: 3px solid var(--border);
  }

  .services-footer-note {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .services-support-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .services-support-link span { transition: transform var(--transition-fast); }
  .services-support-link:hover span { transform: translateX(4px); }
  .services-support-link:focus-visible { outline: 3px solid var(--text); outline-offset: 4px; }

  .services-footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md) var(--space-xl);
  }

  @media (max-width: 900px) {
    .service-feature {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .feature-num {
      font-size: clamp(4rem, 14vw, 6.5rem);
    }
  }

  @media (max-width: 760px) {
    .services-header { display: block; }
    .services-lead {
      max-width: 46ch;
      margin-bottom: var(--space-lg);
    }
    .services-header h2 {
      font-size: clamp(2.35rem, 9vw, 4.25rem);
      line-height: 0.9;
      text-align: left;
    }
  }

  @media (max-width: 1024px) {
    .solutions-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .solutions-list { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .service-feature { padding: var(--space-lg); box-shadow: 8px 8px 0 var(--border); }
    .feature-num { font-size: clamp(3.5rem, 20vw, 5rem); }
    .service-row { box-shadow: 6px 6px 0 var(--border); }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-feature,
    .feature-corner,
    .feature-link,
    .feature-link span,
    .service-row,
    .row-link,
    .row-link span,
    .services-support-link span {
      transition: none;
    }
  }
</style>
