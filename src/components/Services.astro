---
import { serviceAreas, servicesCopy, type ServiceArea } from "../data/services";
import { getSolutionForService, solutionPath } from "../data/solutions";
---

<section class="services" id="servicios" aria-labelledby="services-title">
  <span class="section-tag">{servicesCopy.label}</span>
  <div class="container">
    <header class="services-header reveal">
      <h2 id="services-title" class="section-title">
        {servicesCopy.titleLine}<br /><span class="title-mark">{servicesCopy.titleHighlight}</span>
      </h2>
    </header>

    <ul class="solutions-grid reveal" role="list" id="services-grid">
      {
        serviceAreas.map((service: ServiceArea, index) => {
          const solution = getSolutionForService(service.id);
          return (
            <li
              class:list={["service-card", `sol-${index}`]}
              id={`sol-${service.id}`}
              aria-labelledby={`sol-${service.id}-title`}
            >
              <span class="card-number mono" aria-hidden="true">{service.num}</span>
              <div class="card-content">
                <h3 class="card-title" id={`sol-${service.id}-title`}>
                  {service.title}
                </h3>
                <p class="card-desc">{service.short}</p>
              </div>
              <a
                class="service-link"
                href={solution ? solutionPath(solution.slug) : "/#contacto"}
              >
                {solution ? solution.h1 : "Consultar alcance"}
                <span aria-hidden="true">→</span>
              </a>
              <span class="card-corner" aria-hidden="true">↗</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
    scroll-margin-top: var(--layout-header-height);
  }

  .services::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .services-header {
    display: flex;
    align-items: end;
    justify-content: flex-end;
    gap: var(--space-xl);
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .services-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5.7vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-md), 2.5vw, var(--space-xl));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-card {
    --card-ink: var(--text);
    --card-paper: var(--bg);
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(17rem, 28vw, 23rem);
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(var(--space-lg), 3.2vw, var(--space-2xl));
    border: 3px solid var(--border);
    background: var(--card-paper);
    color: var(--card-ink);
    transition: transform 280ms var(--motion-ease-out), box-shadow 280ms var(--motion-ease-out), background-color 280ms var(--motion-ease-out), color 280ms var(--motion-ease-out);
  }

  .sol-1 { --card-ink: var(--bg); --card-paper: var(--text); }
  .sol-2 { --card-ink: var(--text-on-accent); --card-paper: var(--accent); }

  .card-number {
    width: fit-content;
    font-size: clamp(4.5rem, 8vw, 7.5rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.1em;
    color: var(--card-ink);
    opacity: 0.8;
    transition: transform 350ms var(--motion-ease-out), color 350ms ease;
  }

  .card-content {
    position: relative;
    z-index: 1;
    max-width: 33rem;
    padding-right: var(--space-2xl);
  }

  .card-title {
    max-width: 17ch;
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.4rem, 2.9vw, 2.5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.05em;
    transition: transform 350ms var(--motion-ease-out);
  }

  .card-desc {
    max-width: 42ch;
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    font-size: clamp(0.875rem, 1.25vw, 1rem);
    line-height: 1.5;
    opacity: 0.76;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-corner {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    font-size: 1.125rem;
    transition: transform 280ms var(--motion-ease-out), background-color 280ms ease;
  }

  .service-link {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    width: fit-content;
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-transform: uppercase;
  }

  .service-link:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 4px;
  }

  .service-card:hover {
    transform: translate(-6px, -6px);
    box-shadow: 10px 10px 0 var(--border);
  }

  .service-card:hover .card-number {
    transform: translate(6px, -3px) rotate(-4deg);
    color: var(--accent);
    opacity: 1;
  }

  .sol-2:hover .card-number { color: var(--text-on-accent); }

  /* Dark theme: the inverted card is near-white, so its numeral stays on ink. */
  :global([data-theme="dark"]) .sol-1:hover .card-number {
    color: var(--text-on-accent);
  }

  .service-card:hover .card-title { transform: translateX(4px); }

  .service-card:hover .card-corner {
    transform: translate(3px, -3px);
    background: var(--accent);
    color: var(--text-on-accent);
  }

  @media (max-width: 760px) {
    .services-header { display: block; }
    .services-header h2 {
      font-size: clamp(2.35rem, 9vw, 4.25rem);
      line-height: 0.9;
      text-align: left;
    }
    .service-card { min-height: 16rem; }
    .card-content { padding-right: 0; }
    .card-number { font-size: clamp(4rem, 14vw, 5.5rem); }
  }

  @media (max-width: 560px) {
    .solutions-grid { grid-template-columns: 1fr; gap: var(--space-md); }
    .service-card { min-height: 13.5rem; padding: var(--space-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card, .card-number, .card-title, .card-corner { transition: none; }
  }
</style>
