---
const currentYear = new Date().getFullYear();
import { portfolioLink, siteConfig, socialLinks } from "../data/site";
import { serviceAreas } from "../data/services";

const marqueeItems = ["FRN.Q", "ECOMMERCE", "PORTALES B2B", "SISTEMAS", "GROWTH"];
---

<footer class="footer" role="contentinfo">
  <div class="footer-top">
    <div class="container">
      <div class="top-content">
        <div class="footer-brand">
          <a href="/" class="brand-logo" aria-label="{siteConfig.name} — Inicio">
            <div class="logo-icon" aria-hidden="true">
              <span></span><span></span>
              <span></span><span></span>
            </div>
            <span class="logo-text">{siteConfig.name}</span>
          </a>
          <p class="brand-tagline">{siteConfig.tagline}</p>
        </div>

        <div class="footer-cols">
          <nav class="footer-col" aria-label="Soluciones">
            <h2 class="col-title mono">Soluciones</h2>
            {serviceAreas.map((area) => <a href={`/#sol-${area.id}`}>{area.title}</a>)}
          </nav>

          <div class="footer-col">
            <h2 class="col-title mono">Contacto</h2>
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            <span>{siteConfig.location.city} / España</span>
            <a
              class="portfolio-link"
              href={portfolioLink.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {portfolioLink.label} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-cta">
    <div class="container">
      <a href={`mailto:${siteConfig.email}`} class="cta-large">
        <span class="cta-label mono">¿Hablamos?</span>
        <span class="cta-email">
          <span>{siteConfig.email}</span>
          <span class="cta-cursor" aria-hidden="true">_</span>
        </span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <div class="bottom-content">
        <div class="bottom-left">
          <span class="copyright">© {currentYear} {siteConfig.name}</span>
          <span class="separator" aria-hidden="true">/</span>
          <span class="location">{siteConfig.location.city}, España</span>
        </div>

        <div class="bottom-right">
          <div class="social-links" role="list" aria-label="Redes sociales">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  class="social-link"
                  title={social.title}
                  role="listitem"
                  aria-label={social.title}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {social.label}
                </a>
              ))
            }
          </div>

          <button
            class="back-top"
            id="back-top"
            aria-label="Volver arriba"
            type="button"
          >
            <span aria-hidden="true">↑</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        Array.from({ length: 3 }).map(() => (
          <>
            {marqueeItems.map((item) => (
              <>
                <span>{item}</span>
                <span class="marquee-sep">◆</span>
              </>
            ))}
          </>
        ))
      }
    </div>
  </div>
</footer>

<script>
  const backTopBtn = document.getElementById("back-top");

  backTopBtn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // Show/hide back to top based on scroll
  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        backTopBtn?.classList.toggle("is-visible", window.scrollY > 500);
        ticking = false;
      });
    },
    { passive: true },
  );
</script>

<style>
  .footer {
    --y: var(--accent);
    border-top: 3px solid var(--border);
    background: var(--bg);
    position: relative;
    overflow: hidden;
  }

  .mono {
    font-family: var(--font-mono);
  }

  /* ---- Top ---- */
  .footer-top {
    padding: var(--space-2xl) 0;
    border-bottom: 3px solid var(--border);
  }

  .top-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .top-content {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-3xl);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: var(--shadow-brutal);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .brand-logo:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--border);
  }

  .brand-logo:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .logo-icon {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    width: 20px;
    height: 20px;
  }

  .logo-icon span {
    background: var(--text);
  }

  .logo-text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
  }

  .brand-tagline {
    font-size: 0.875rem;
    opacity: 0.6;
    font-style: italic;
    margin: 0;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 700px) {
    .footer-cols {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .footer-col {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }

  .col-title {
    margin-bottom: 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.52;
  }

  .footer-col a,
  .footer-col span {
    font-size: 0.82rem;
    line-height: 1.6;
    width: fit-content;
  }

  .footer-col a:hover {
    opacity: 0.58;
    text-decoration: underline;
    text-decoration-color: var(--y);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .portfolio-link {
    font-weight: 650;
  }

  /* ---- Big CTA ---- */
  .footer-cta {
    padding: var(--space-3xl) 0;
    border-bottom: 3px solid var(--border);
    text-align: center;
  }

  .cta-large {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xl) var(--space-2xl);
    border: 3px solid var(--text);
    background: var(--text);
    color: var(--bg);
    box-shadow: 8px 8px 0 var(--y);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    position: relative;
    max-width: 100%;
  }

  .cta-large:hover {
    transform: translate(-8px, -8px);
    box-shadow: 14px 14px 0 var(--y);
  }

  .cta-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }

  .cta-email {
    font-family: var(--font-mono);
    font-size: clamp(1.375rem, 4.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .cta-arrow {
    position: absolute;
    right: var(--space-lg);
    bottom: var(--space-lg);
    font-size: 1.5rem;
    transition: transform var(--transition-base);
  }

  .cta-large:hover .cta-arrow {
    transform: translateX(8px);
  }

  /* Terminal cursor blink */
  .cta-cursor {
    display: inline-block;
    font-weight: 300;
    opacity: 1;
    animation: cursorBlink 1.1s step-start infinite;
    margin-left: 2px;
  }

  .cta-large:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  /* ---- Bottom ---- */
  .footer-bottom {
    padding: var(--space-lg) 0;
  }

  .bottom-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (min-width: 700px) {
    .bottom-content {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .bottom-left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .separator {
    opacity: 0.4;
  }

  .bottom-right {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .social-links {
    display: flex;
    gap: var(--space-xs);
  }

  .social-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    background: var(--text);
    color: var(--bg);
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--border);
  }

  .social-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .back-top {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border);
    background: var(--bg);
    font-size: 1rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all var(--transition-base);
  }

  .back-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-top:hover {
    background: var(--text);
    color: var(--bg);
  }

  .back-top:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  /* ---- Bottom marquee ---- */
  .footer-marquee {
    border-top: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    padding: var(--space-md) 0;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee 30s linear infinite;
    will-change: transform;
  }

  .marquee-track span {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
    padding: 0 var(--space-md);
  }

  .marquee-sep {
    opacity: 0.4;
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
