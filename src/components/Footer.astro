---
const currentYear = new Date().getFullYear();
import { portfolioLink, siteConfig, socialLinks } from "../data/site";
---

<footer class="footer" role="contentinfo">
  <div class="footer-top">
    <div class="container footer-top-inner">
      <div class="footer-brand">
        <span class="brand-caption mono">{siteConfig.location.city} / España</span>
        <a href="/#inicio" class="brand-name" aria-label={`${siteConfig.name} — Inicio`}>
          {siteConfig.name}
        </a>
      </div>
      <div class="footer-contact">
        <span class="contact-caption mono">Escríbeme</span>
        <a href={`mailto:${siteConfig.email}`} class="contact-address">
          {siteConfig.email}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <nav class="footer-nav" aria-label="Navegación del pie">
        <a href="/#inicio">Inicio</a>
        <a href="/#servicios">Soluciones</a>
        <a href="/casos/">Casos</a>
        <a href="/#sobre-mi">Estudio</a>
        <a href="/#contacto">Contacto</a>
        <a href="/legal/">Aviso legal</a>
        <a href="/legal/privacidad/">Privacidad</a>
        <a href={portfolioLink.href} target="_blank" rel="noopener noreferrer" class="portfolio-link mono" aria-label={portfolioLink.title}>
          {portfolioLink.label} <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <div class="footer-meta">
        <span class="copyright mono">© {currentYear} {siteConfig.name}</span>
        <nav class="social-links" aria-label="Redes sociales">
          {socialLinks.map((social) => (
            <a href={social.href} class="social-link mono" title={social.title} aria-label={social.title} target="_blank" rel="noopener noreferrer">
              {social.label}
            </a>
          ))}
        </nav>
        <button class="back-top mono" id="back-top" aria-label="Volver arriba" type="button">↑</button>
      </div>
    </div>
  </div>
</footer>

<script>
  const backTopBtn = document.getElementById("back-top");
  backTopBtn?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  let ticking = false;
  window.addEventListener("scroll", () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      backTopBtn?.classList.toggle("is-visible", window.scrollY > 500);
      ticking = false;
    });
  }, { passive: true });
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    border-top: 4px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }

  .mono { font-family: var(--font-mono); }

  .footer-top {
    padding: clamp(var(--space-2xl), 5vw, var(--space-4xl)) 0;
    border-bottom: 2px solid var(--border);
  }

  .footer-top-inner { display: flex; align-items: end; justify-content: space-between; gap: var(--space-2xl); }
  .footer-brand { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }

  .brand-caption, .contact-caption {
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-name {
    display: block;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.1em;
    color: var(--text);
  }

  .brand-name::after {
    display: inline-block;
    width: 0.1em;
    aspect-ratio: 1;
    margin-left: 0.14em;
    content: "";
    background: var(--accent);
  }

  .footer-contact { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-sm); padding-bottom: 0.15em; }

  .contact-address {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-xs) 0;
    border-bottom: 3px solid var(--accent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.75vw, 1.375rem);
    font-weight: 700;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .contact-address:hover { border-color: var(--text); }
  .contact-address span { transition: transform var(--transition-fast); }
  .contact-address:hover span { transform: translate(3px, -3px); }
  .footer-bottom { padding: var(--space-lg) 0; border-top: 2px solid var(--border); background: var(--bg-alt); }
  .footer-bottom-inner, .footer-nav, .footer-meta, .social-links { display: flex; align-items: center; }
  .footer-bottom-inner { justify-content: space-between; gap: var(--space-xl); }
  .footer-nav { flex-wrap: wrap; gap: var(--space-lg); }

  .footer-nav a { font-size: 0.8125rem; font-weight: 700; transition: color var(--transition-fast); }
  .footer-nav a:hover { color: var(--text-muted); }

  .footer-nav a:focus-visible, .social-link:focus-visible, .back-top:focus-visible, .contact-address:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  .footer-nav .portfolio-link { color: var(--text-muted); font-size: 0.625rem; letter-spacing: 0.08em; }
  .footer-nav .portfolio-link:hover { color: var(--text); }
  .footer-meta { gap: var(--space-lg); }
  .copyright { color: var(--text-muted); font-size: 0.625rem; letter-spacing: 0.08em; white-space: nowrap; }
  .social-links { gap: var(--space-xs); }

  .social-link, .back-top {
    display: grid;
    width: 2.25rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.625rem;
    font-weight: 700;
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .social-link:hover, .back-top:hover { transform: translate(-2px, -2px); background: var(--accent); color: var(--text-on-accent); }
  .back-top { cursor: pointer; opacity: 0; visibility: hidden; }
  .back-top.is-visible { opacity: 1; visibility: visible; }

  @media (max-width: 900px) {
    .footer-bottom-inner { align-items: flex-start; flex-direction: column; }
    .footer-meta { width: 100%; justify-content: space-between; }
  }

  @media (max-width: 600px) {
    .footer-top-inner { align-items: flex-start; flex-direction: column; gap: var(--space-xl); }
    .brand-name { font-size: clamp(3.25rem, 16vw, 5rem); }
    .footer-contact { align-items: flex-start; }
    .footer-nav { gap: var(--space-md) var(--space-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-address, .contact-address span, .social-link, .back-top { transition: none; }
  }
</style>
