---
const currentYear = new Date().getFullYear();
import { portfolioLink, siteConfig, socialLinks } from "../data/site";
import { isGa4MeasurementId } from "../scripts/analytics";
import { analyticsConsentCopy } from "../data/analytics-consent";
const hasAnalytics = isGa4MeasurementId(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID);

// Minimal footer index: one label/href pair per route, numbered as a datasheet.
const footerLinks = [
  { href: "/#servicios", label: "Soluciones" },
  { href: "/precios/", label: "Precios" },
  { href: "/soluciones/revision-web/", label: "Reparación web" },
  { href: "/casos/", label: "Casos" },
  { href: "/guias/", label: "Guías" },
  { href: "/soporte/", label: "Soporte" },
  { href: "/colaboraciones/agencias/", label: "Colaboraciones" },
  { href: "/#contacto", label: "Contacto" },
  { href: "/legal/", label: "Aviso legal" },
  { href: "/legal/privacidad/", label: "Privacidad" },
];
---

<footer class="footer" role="contentinfo">
  <!-- Inverted ink panel with an accent base line: the page's closing plate -->
  <div class="footer-panel">
    <div class="container">
      <!-- Signage row -->
      <div class="footer-sign reveal">
        <span class="footer-tag mono">Escríbeme</span>
        <span class="footer-locale mono">{siteConfig.location.city} / España</span>
      </div>

      <a
        href={`mailto:${siteConfig.email}`}
        class="footer-mail reveal"
        style="--reveal-delay: 120ms;"
        data-track="contact_method_click"
        data-track-method="email"
        data-track-location="footer"
      >
        {siteConfig.email}<span class="mail-arrow" aria-hidden="true">↗</span>
      </a>

      <div class="footer-rule" aria-hidden="true"></div>

      <!-- Asymmetric close: brand block | numbered index -->
      <div class="footer-main">
        <div class="footer-brand reveal" style="--reveal-delay: 240ms;">
          <a href="/#inicio" class="brand-name" aria-label={`${siteConfig.name} — Inicio`}>
            {siteConfig.name}
          </a>
          <p class="brand-tagline mono">{siteConfig.tagline}</p>
        </div>

        <nav class="footer-index reveal" style="--reveal-delay: 320ms;" aria-label="Navegación del pie">
          <ul class="index-list">
            {footerLinks.map((link, i) => (
              <li>
                <a class="index-link" href={link.href}>
                  <span class="index-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          {hasAnalytics && (
            <button type="button" class="analytics-settings" data-analytics-settings hidden>
              {analyticsConsentCopy.settings}
            </button>
          )}
        </nav>
      </div>

      <!-- Meta bar -->
      <div class="footer-meta reveal" style="--reveal-delay: 400ms;">
        <span class="copyright mono">© {currentYear} {siteConfig.name} — {siteConfig.fullName}</span>
        <div class="meta-right">
          <nav class="social-links" aria-label="Redes sociales">
            {socialLinks.map((social) => (
              <a href={social.href} class="social-link mono" title={social.title} aria-label={social.title} target="_blank" rel="noopener noreferrer">
                {social.label}
              </a>
            ))}
          </nav>
          <a
            href={portfolioLink.href}
            target="_blank"
            rel="noopener noreferrer"
            class="meta-studio mono"
            aria-label={portfolioLink.title}
            data-track="studio_link_click"
            data-track-location="footer"
          >
            {portfolioLink.label} <span class="meta-studio-arrow" aria-hidden="true">↗</span>
          </a>
          <button class="back-top mono" id="back-top" aria-label="Volver arriba" type="button">↑</button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const backTopBtn = document.getElementById("back-top");
  backTopBtn?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  let ticking = false;
  window.addEventListener("scroll", () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      backTopBtn?.classList.toggle("is-visible", window.scrollY > 500);
      ticking = false;
    });
  }, { passive: true });
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    border-top: 4px solid var(--border);
  }

  .mono { font-family: var(--font-mono); }

  /* ---- Inverted closing plate ---- */

  .footer-panel {
    padding: clamp(var(--space-3xl), 6vw, var(--space-4xl)) 0 clamp(var(--space-lg), 3vw, var(--space-xl));
    background: var(--text);
    color: var(--bg);
    border-bottom: 6px solid var(--accent);
  }

  /* ---- Signage row ---- */

  .footer-sign {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  /* Mono signage with the accent square of the section tag plate. */
  .footer-tag {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-tag::before {
    width: 0.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--bg);
    background: var(--accent);
    content: "";
  }

  .footer-locale {
    color: var(--bg);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* ---- Giant mailto plate: the closing commercial plate of the page.
     Flat ink frame at rest; lifts with the hard accent offset shadow on
     interaction — the same signature device as the price and method plates. */

  .footer-mail {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.5rem);
    border: 3px solid var(--bg);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: clamp(1.625rem, 4.8vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .footer-mail:hover,
  .footer-mail:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--accent);
  }

  .mail-arrow {
    flex-shrink: 0;
    margin-left: auto;
    font-size: 0.55em;
    transition: transform var(--transition-base);
  }

  .footer-mail:hover .mail-arrow,
  .footer-mail:focus-visible .mail-arrow { transform: translate(4px, -4px); }

  /* ---- Dashed industrial divider, ink-panel variant ---- */

  .footer-rule {
    height: 2px;
    margin: clamp(var(--space-xl), 4vw, var(--space-2xl)) 0 clamp(var(--space-2xl), 5vw, var(--space-3xl));
    background: repeating-linear-gradient(90deg, var(--bg) 0 18px, transparent 18px 36px);
    opacity: 0.4;
  }

  /* ---- Brand block | numbered index ---- */

  .footer-main {
    --index-gap: clamp(var(--space-2xl), 5vw, var(--space-3xl));
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--index-gap);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .brand-name {
    display: block;
    font-size: clamp(3.5rem, 8.5vw, 7.5rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.09em;
    color: var(--bg);
  }

  .brand-name::after {
    display: inline-block;
    width: 0.1em;
    aspect-ratio: 1;
    margin-left: 0.14em;
    content: "";
    background: var(--accent);
    transition: transform var(--transition-base);
  }

  .brand-name:hover::after { transform: translate(4px, -4px); }

  .brand-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .brand-tagline::before {
    flex-shrink: 0;
    width: 1.75rem;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .footer-index {
    position: relative;
  }

  /* Vertical dashed rail in the column gap, full block height. */
  .footer-index::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--index-gap) / -2);
    width: 2px;
    background: repeating-linear-gradient(180deg, var(--bg) 0 14px, transparent 14px 28px);
    opacity: 0.4;
  }

  .index-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(5, 1fr);
    height: 100%;
    gap: 0 var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index-list li {
    display: flex;
    align-items: center;
  }

  .index-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.65rem;
    width: 100%;
    padding: 0.3rem 0;
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    opacity: 0.6;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .index-num {
    min-width: 2em;
    color: var(--bg);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    opacity: 0.7;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .index-link:hover,
  .index-link:focus-visible {
    opacity: 1;
    transform: translateX(3px);
  }

  .index-link:hover .index-num,
  .index-link:focus-visible .index-num {
    color: var(--accent);
    opacity: 1;
  }

  .index-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Hard arrow waits at the row's right edge, like the plate arrows. */
  .index-link::after {
    content: "→";
    margin-left: auto;
    font-size: 0.875em;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .index-link:hover::after,
  .index-link:focus-visible::after {
    opacity: 1;
    transform: translateX(0);
  }

  .analytics-settings {
    margin-top: var(--space-md);
    padding: 0;
    border: 0;
    background: none;
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    opacity: 0.6;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .analytics-settings:hover { opacity: 1; }
  .analytics-settings[hidden] { display: none; }

  /* ---- Meta bar ---- */

  .footer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: clamp(var(--space-2xl), 5vw, var(--space-3xl));
    padding-top: var(--space-md);
    border-top: 2px solid var(--bg);
  }

  .copyright {
    color: var(--bg);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    opacity: 0.6;
    white-space: nowrap;
  }

  .meta-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .social-link, .back-top {
    display: grid;
    width: 2.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid var(--bg);
    color: var(--bg);
    font-size: 0.625rem;
    font-weight: 700;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .social-link:hover, .back-top:hover {
    transform: translate(-2px, -2px);
    border-color: var(--accent);
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .back-top { cursor: pointer; font-size: 0.875rem; opacity: 0; visibility: hidden; }
  .back-top.is-visible { opacity: 1; visibility: visible; }

  /* Secondary textual link: never competes with the highlighted CTA. */
  .meta-studio {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--bg);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    opacity: 0.85;
    transition:
      opacity var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .meta-studio:hover {
    opacity: 1;
    text-decoration-color: var(--accent);
  }

  .meta-studio-arrow { transition: transform var(--transition-fast); }
  .meta-studio:hover .meta-studio-arrow { transform: translate(2px, -2px); }

  /* ---- Focus (inverted panel: paper outline) ---- */

  .footer-mail:focus-visible,
  .brand-name:focus-visible,
  .index-link:focus-visible,
  .analytics-settings:focus-visible,
  .social-link:focus-visible,
  .meta-studio:focus-visible {
    outline: 3px solid var(--bg);
    outline-offset: 4px;
  }

  .back-top:focus-visible {
    outline: 3px solid var(--bg);
    outline-offset: 3px;
  }

  /* ---- Responsive recomposition ---- */

  @media (max-width: 899px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .footer-index::before { content: none; }
    .index-list { height: auto; grid-template-rows: repeat(5, auto); }
  }

  @media (max-width: 600px) {
    .footer-sign { margin-bottom: var(--space-md); }

    .footer-mail {
      gap: var(--space-md);
      padding: var(--space-md) var(--space-lg);
      font-size: clamp(1.375rem, 7.5vw, 2rem);
    }

    .footer-rule { margin: var(--space-xl) 0 var(--space-2xl); }

    .brand-name { font-size: clamp(3.5rem, 17vw, 5.5rem); }
    .index-list { gap: var(--space-xs) var(--space-md); }
    .index-link { padding: 0.4rem 0; font-size: 0.75rem; }
    .index-num { font-size: 0.5625rem; }

    .footer-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-mail,
    .mail-arrow,
    .brand-name::after,
    .index-link,
    .index-link::after,
    .index-num,
    .social-link,
    .back-top,
    .meta-studio,
    .meta-studio-arrow {
      transition: none;
    }
  }
</style>
