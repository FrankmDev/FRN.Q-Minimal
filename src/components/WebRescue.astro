---
import { webRescueCopy, webRescuePage } from "../data/web-rescue";
---

<section class="rescue" id="revision-web" aria-labelledby="rescue-title">
  <span class="section-tag">{webRescueCopy.label}</span>
  <div class="container">
    <header class="rescue-header reveal">
      <h2 id="rescue-title" class="section-title">
        {webRescueCopy.titleLine}<br /><span class="title-mark">{webRescueCopy.titleHighlight}</span>
      </h2>
      <p class="rescue-lead">{webRescueCopy.lead}</p>
    </header>

    <ol class="rescue-steps reveal" aria-label="Proceso de revisión y reparación">
      {
        webRescueCopy.steps.map((step) => (
          <li class="rescue-step">
            <span class="step-num mono" aria-hidden="true">{step.num}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </li>
        ))
      }
    </ol>

    <div class="rescue-body">
      <ul class="rescue-prices reveal" aria-label="Ofertas de revisión y reparación">
        {
          webRescueCopy.prices.map((price, index) => (
            <li class:list={["rescue-price", { "rescue-price-primary": index === 0 }]}>
              <div class="price-head">
                <span class="price-num mono" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="price-value mono">
                  {price.qualifier && <span class="price-qualifier">{price.qualifier}</span>}
                  <span class="price-amount">{price.amountLabel ?? price.price}</span>
                </p>
              </div>
              <h3 class="price-title">{price.title}</h3>
              <p class="price-detail">{price.detail}</p>
            </li>
          ))
        }
      </ul>

      <aside class="rescue-market reveal" aria-labelledby="rescue-market-title">
        <div class="market-head">
          <h3 class="market-title" id="rescue-market-title">
            {webRescueCopy.market.titleLine}{" "}
            <span class="title-mark">{webRescueCopy.market.titleHighlight}</span>
          </h3>
          <span class="market-corner" aria-hidden="true">↗</span>
        </div>

        <ul class="market-audience" aria-label="Tipos de negocio">
          {webRescueCopy.market.audience.map((item) => <li>{item}</li>)}
        </ul>

        <ul class="market-list" aria-label="Áreas de trabajo">
          {webRescueCopy.market.cases.map((item, index) => (
            <li>
              <span class="market-num mono" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <p class="market-note">{webRescueCopy.market.disclaimer}</p>

        <a
          class="market-action"
          href="#contacto"
          data-contact-type={webRescueCopy.market.cta.type}
          data-track="cta_click"
          data-track-location="revision_web"
          data-track-label={webRescueCopy.market.cta.label}
        >
          <span>{webRescueCopy.market.cta.label}</span>
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>

    <div class="rescue-footer reveal">
      <div class="rescue-footer-copy">
        <p class="rescue-note">{webRescueCopy.note} Importes sin impuestos; licencias y otros costes externos aparte.</p>
        <a
          class="rescue-page-link"
          href={webRescuePage.path}
          data-track="cta_click"
          data-track-location="revision_web"
          data-track-label={webRescuePage.label}
        >
          {webRescuePage.label}: proceso, alcance y precios <span aria-hidden="true">→</span>
        </a>
      </div>
      <a
        href="#contacto"
        class="rescue-cta"
        data-contact-type={webRescueCopy.cta.type}
        data-track="cta_click"
        data-track-location="revision_web"
        data-track-label={webRescueCopy.cta.label}
      >
        <span>{webRescueCopy.cta.label}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .rescue {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
  }

  .rescue::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .rescue-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(var(--space-xl), 4vw, var(--space-3xl));
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .rescue-header h2 {
    order: 2;
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .rescue-lead {
    order: 1;
    max-width: 26rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    line-height: 1.55;
  }

  .rescue-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0 0 clamp(var(--space-2xl), 5vw, var(--space-3xl));
    padding: 0;
    list-style: none;
  }

  .rescue-step {
    padding-top: var(--space-md);
    border-top: 3px solid var(--border);
  }

  .step-num {
    display: block;
    margin-bottom: var(--space-md);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .step-title {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.125rem, 2vw, 1.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .step-desc {
    max-width: 30ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .rescue-body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(var(--space-xl), 4vw, var(--space-3xl));
  }

  .rescue-prices {
    display: grid;
    grid-auto-rows: 1fr;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rescue-price {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: clamp(var(--space-lg), 2.6vw, var(--space-xl));
    border: 3px solid var(--border);
    background: var(--bg);
    box-shadow: 8px 8px 0 var(--border);
    transition: transform var(--transition-card), box-shadow var(--transition-card-shadow);
  }

  .rescue-price:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--border);
  }

  /* Hover signature: the accent rule inks across the top edge, left to right. */
  .rescue-price::after {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
    content: "";
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .rescue-price:hover::after { transform: scaleX(1); }

  /* The accent-filled entry plate already carries the colour. */
  .rescue-price-primary::after { display: none; }

  .rescue-price-primary {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  /* Header row: signage slot (square, numeral, dashed rail) with the amount
     aligned right, so every plate opens with its price. */
  .price-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .price-num {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: clamp(0.9375rem, 1.4vw, 1.125rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-num::before {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    background: var(--accent);
    content: "";
  }

  .price-num::after {
    flex: 1 1 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 8px, transparent 8px 16px);
    opacity: 0.45;
    content: "";
  }

  .rescue-price-primary .price-num::before {
    border-color: var(--text-on-accent);
    background: var(--text-on-accent);
  }

  .price-title {
    margin: 0;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* Qualifier and amount split so the number carries the hierarchy on its own. */
  .price-value {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.35em var(--space-xs);
    margin: 0;
  }

  .price-qualifier {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .price-amount {
    font-size: clamp(1.5rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-detail {
    margin: 0;
    max-width: 44ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  .rescue-market {
    --market-pad: clamp(var(--space-lg), 3vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    padding: var(--market-pad) var(--market-pad) 0;
    border: 3px solid var(--border);
    border-top: 4px solid var(--accent);
    background: var(--text);
    color: var(--bg);
    box-shadow: 8px 8px 0 var(--border);
    transition: transform var(--transition-card), box-shadow var(--transition-card-shadow);
  }

  /* The panel answers the three plates' hover response so the row reads as
     one composed set of four. */
  .rescue-market:hover {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--border);
  }

  .market-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin: 0 0 var(--space-lg);
  }

  .market-title {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  /* Reuse the section-title mark on the panel: muted ink becomes paper on ink. */
  .market-title .title-mark { color: var(--bg); }

  /* Accent corner plate, tying the panel to the primary plate's yellow. */
  .market-corner {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.4rem;
    aspect-ratio: 1;
    border: 2px solid var(--text-on-accent);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: 1.05rem;
    line-height: 1;
  }

  /* Audience signage: mono tags split by accent slashes, ruled off from the list. */
  .market-audience {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    margin: 0 0 var(--space-lg);
    padding: 0 0 var(--space-sm);
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 22%, transparent);
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .market-audience li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .market-audience li:not(:last-child)::after {
    color: var(--text-accent-inverse);
    content: "/";
  }

  .market-list {
    flex: 1 1 auto;
    display: grid;
    grid-auto-rows: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .market-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-top: 1px solid color-mix(in srgb, var(--bg) 22%, transparent);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .market-list li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  /* Numbered square badge, echoing the About process panel numerals. */
  .market-num {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid var(--accent);
    background: var(--text);
    color: var(--text-accent-inverse);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
  }

  .market-note {
    margin: var(--space-md) 0 var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--bg) 24%, transparent);
    font-size: 0.8125rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  /* Full-bleed action band pinned to the panel's foot; accent fill on hover. */
  .market-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin: auto calc(-1 * var(--market-pad)) 0;
    padding: var(--space-lg) var(--market-pad);
    border-top: 2px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .market-action span:last-child { transition: transform var(--transition-fast); }

  .market-action:hover {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .market-action:hover span:last-child { transform: translateX(4px); }
  .market-action:focus-visible { outline: 3px solid currentColor; outline-offset: -4px; }

  .rescue-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: clamp(var(--space-2xl), 4vw, var(--space-3xl));
  }

  .rescue-note {
    max-width: 62ch;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .rescue-footer-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 62ch;
  }

  .rescue-page-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    width: fit-content;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-color: var(--border-light);
    text-underline-offset: 0.35em;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .rescue-page-link:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .rescue-page-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  .rescue-page-link span {
    transition: transform var(--transition-fast);
  }

  .rescue-page-link:hover span {
    transform: translateX(4px);
  }

  .rescue-cta {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--space-xl);
    min-height: 3.25rem;
    padding: var(--space-sm) var(--space-lg);
    border: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    box-shadow: 6px 6px 0 var(--accent);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .rescue-cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 var(--accent);
  }

  .rescue-cta:hover span:last-child { transform: translateX(4px); }
  .rescue-cta span:last-child { transition: transform var(--transition-fast); }

  .rescue-cta:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .rescue-body {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 760px) {
    .rescue-header { display: block; }
    .rescue-lead {
      max-width: 46ch;
      margin-bottom: var(--space-lg);
    }
    .rescue-header h2 {
      font-size: clamp(2.35rem, 9vw, 4.25rem);
      line-height: 0.9;
      text-align: left;
    }
    .rescue-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-xl);
    }
  }

  @media (max-width: 540px) {
    .rescue-steps { grid-template-columns: 1fr; gap: var(--space-md); }
    .rescue-footer { align-items: flex-start; flex-direction: column; }
    .rescue-cta { width: 100%; justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rescue-price, .rescue-market, .rescue-cta, .rescue-cta span:last-child, .market-action, .market-action span:last-child, .rescue-page-link span { transition: none; }
    .rescue-price:hover, .rescue-market:hover { transform: none; }
    .market-action:hover span:last-child { transform: none; }
  }
</style>
