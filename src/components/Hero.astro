---
import { portfolioLink } from "../data/site";
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container hero-container">
    <div class="hero-top">
      <p class="hero-eyebrow mono">Estudio independiente · Granada</p>
      <a
        class="portfolio-link mono"
        href={portfolioLink.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={portfolioLink.title}
        data-track="studio_link_click"
        data-track-location="hero"
      >
        {portfolioLink.label} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <h1 class="hero-title" id="hero-title">
      <span class="hero-line hero-line-top">
        <span class="hero-part">Web,</span> <span class="hero-part">comercio</span>
      </span>
      <span class="hero-line hero-line-bottom"><span class="hero-accent">y sistemas.</span></span>
    </h1>

    <div class="hero-figure" aria-hidden="true">
      <span class="figure-square"></span>
      <span class="figure-rule"></span>
      <span class="figure-mark mono">↘</span>
    </div>

    <div class="hero-bottom">
      <p class="hero-desc">
        Presencia digital, canales de venta y sistemas conectados para empresas.
      </p>
      <div class="hero-actions">
        <a
          href="#contacto"
          class="hero-cta"
          data-track="cta_click"
          data-track-location="hero"
          data-track-label="Cuéntame qué necesitas"
        >
          <span>Cuéntame qué necesitas</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/casos/"
          class="hero-work-link"
          data-track="cta_click"
          data-track-location="hero"
          data-track-label="Ver proyectos"
        >
          <span>Ver proyectos</span>
          <span aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* The header is fixed, so it takes no flow space: the hero starts at the
       very top, clears the header with its top padding and runs the full
       100dvh, which puts its bottom rule exactly on the fold. */
    min-height: 100dvh;
    display: flex;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    padding: calc(var(--layout-header-height) + clamp(0.75rem, 2vw, 1.25rem)) 0
      clamp(var(--space-xl), 3vw, var(--space-3xl));
    border-bottom: 3px solid var(--border);
  }

  .hero::after {
    content: "";
    position: absolute;
    width: clamp(15rem, 32vw, 30rem);
    aspect-ratio: 1;
    right: -11%;
    top: 26%;
    border: clamp(2rem, 5vw, 5rem) solid var(--border);
    opacity: 0.05;
    transform: rotate(18deg);
    pointer-events: none;
  }

  .hero-container {
    width: 100%;
    position: relative;
    z-index: 1;
    /* Fills the hero height so the free space is spent inside the
       composition instead of floating the block as a whole. */
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-lg), 2vw, var(--space-2xl));
  }

  .mono {
    font-family: var(--font-mono);
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    /* Spacing between the top row, the headline and the close is owned by
       the container gap. */
    margin-bottom: 0;
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .portfolio-link {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-light);
    text-underline-offset: 5px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .portfolio-link:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .portfolio-link:focus-visible,
  .hero-cta:focus-visible,
  .hero-work-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  .hero-title {
    position: relative;
    width: fit-content;
    max-width: 100%;
    /* Two uppercase lines take 1.78em (2 × 0.84 line-height plus the 0.1em
       margin of the accent line). The width term holds the longer line at
       ~85% of the container; the height term caps the size so the hero
       still clears the fixed header and fits the first screen. */
    font-size: clamp(2.9rem, min(10.5vw, calc(56svh - 13rem)), 8.25rem);
    line-height: 0.84;
    letter-spacing: -0.085em;
    font-weight: 800;
    text-transform: uppercase;
    /* Shares the spare height with the close block below, so the headline
       sits slightly above the optical centre while the label row stays under
       the header and the description/actions close the hero on the fold. */
    margin-block: auto;
    animation: fadeInUp 0.8s var(--motion-ease-out) both;
  }

  .hero-line {
    display: block;
    white-space: nowrap;
  }

  /* Both words share the first line on wide viewports; on phones each one
     takes its own line (see the 720px block) so the headline can be much
     larger without leaving the container. */
  .hero-part {
    display: inline;
  }

  .hero-line-bottom {
    display: flex;
    align-items: center;
    gap: 0.12em;
    margin-top: 0.1em;
    padding-left: 0.52em;
  }

  .hero-accent {
    padding: 0.04em 0.12em 0.1em;
    background: var(--accent);
    color: var(--text-on-accent);
    box-shadow: 0.08em 0.08em 0 var(--border);
  }

  /* Structural spine: an industrial dashed rule with an accent marker and a
     hard arrow, closing the headline block and dividing the middle band of
     the hero instead of leaving it blank. Decorative only. */
  .hero-figure {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    animation: fadeInUp 0.8s var(--motion-ease-out) 60ms both;
  }

  .figure-square {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .figure-rule {
    flex: 1 1 auto;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--border) 0 18px,
      transparent 18px 36px
    );
  }

  .figure-mark {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-2xl);
    /* Third auto margin: the spare height splits into thirds between the
       label row, the headline and this block. */
    margin-top: auto;
    padding-left: 0.52em;
    animation: fadeInUp 0.8s var(--motion-ease-out) 120ms both;
  }

  .hero-desc {
    max-width: 38ch;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-lg);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 3.5rem;
    padding: var(--space-md) var(--space-lg);
    border: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    box-shadow: 7px 7px 0 var(--accent);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .hero-cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 11px 11px 0 var(--accent);
  }

  .hero-cta span:last-child,
  .hero-work-link span:last-child {
    transition: transform var(--transition-fast);
  }

  .hero-cta:hover span:last-child {
    transform: translateX(4px);
  }

  .hero-work-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 3rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-work-link:hover span:last-child {
    transform: translate(3px, 3px);
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 100dvh;
      padding: calc(var(--layout-header-height) + var(--space-lg)) 0 var(--space-3xl);
    }

    .hero-top {
      margin-bottom: 0;
    }

    .portfolio-link {
      font-size: 0.58rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .hero-eyebrow {
      font-size: 0.58rem;
      letter-spacing: 0.04em;
    }

    .hero-title {
      /* Three lines on phones: the widest one ('y sistemas.') is ~6.2em, which
         pays for a considerably larger headline than the two-line lockup. The
         top margin drops so the label row and the headline read as one block,
         and the free height is spent around the spine below. */
      margin-top: 0;
      margin-bottom: auto;
      font-size: clamp(2.2rem, min(12.5vw, calc(56svh - 13rem)), 5rem);
      line-height: 0.88;
      letter-spacing: -0.08em;
    }

    .hero-part {
      display: block;
    }

    .hero-line-bottom {
      gap: 0.1em;
      padding-left: 0.2em;
    }

    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-xl);
      padding-left: 0;
    }

    .hero-desc {
      max-width: 32ch;
      font-size: 1rem;
    }

    .hero-actions {
      justify-content: flex-start;
      gap: var(--space-lg);
    }

    .hero-cta {
      /* Full-width plate on phones: it fills the closing band and puts the
         whole primary action inside thumb reach. */
      width: 100%;
      min-height: 3.75rem;
      justify-content: space-between;
      gap: var(--space-md);
    }
  }

  @media (max-width: 380px) {
    .hero-title {
      font-size: 12vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-figure,
    .hero-bottom {
      animation: none;
    }
  }
</style>
