---
import { portfolioLink, siteConfig } from "../data/site";
import { serviceAreas } from "../data/services";

const marqueeItems = [
  ...serviceAreas.map((area) => area.title.toUpperCase()),
  "INTEGRACIONES",
  "ANALÍTICA",
  "AUTOMATIZACIÓN",
  "MEDICIÓN",
];
---

<section class="hero" id="inicio" aria-label="Introducción">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container">
    <!-- Header row -->
    <div class="hero-header">
      <div class="hero-top">
        <span class="top-meta mono">
          Estudio digital / {siteConfig.location.city}
        </span>
        <a
          class="studio-link mono"
          href={portfolioLink.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={portfolioLink.title}
        >
          {portfolioLink.label} <span class="ext" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Main title -->
    <div class="hero-title-block">
      <h1 class="hero-title">
        <span class="ht-b title-bold">
          <span class="bold-accent" aria-hidden="true"></span>
          Ecommerce,
        </span>
        <span class="ht-l">portales B2B y sistemas digitales</span>
        <span class="ht-b">para empresas.</span>
      </h1>
    </div>

    <!-- Marquee band -->
    <div class="hero-marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          Array.from({ length: 2 }).map(() => (
            <span class="marquee-content">
              {marqueeItems.map((item) => (
                <>
                  <span class="mq-word">{item}</span>
                  <span class="mq-dot">·</span>
                </>
              ))}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Bottom row: description + CTA left | index right -->
    <div class="hero-bottom">
      <div class="hero-info">
        <p class="hero-desc">
          FRN.Q diseña y desarrolla soluciones que conectan producto, clientes
          y procesos comerciales, manteniendo web, diseño, SEO y growth como
          parte de la oferta.
        </p>

        <div class="hero-actions">
          <a href="#contacto" class="cta-main">
            <span>Plantear un proyecto</span>
            <span class="cta-arrow" aria-hidden="true">→</span>
          </a>
          <a href="#servicios" class="cta-ghost">
            <span>Ver soluciones / casos</span>
            <span class="ghost-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <nav class="hero-index" aria-label="Índice de soluciones">
        <span class="idx-caption mono">Índice / Soluciones</span>
        <dl class="idx-list" role="list">
          {
            serviceAreas.slice(0, 3).map((item) => (
              <div class="idx-row" role="listitem">
                <dt class="idx-num mono" aria-hidden="true">
                  {item.num}
                </dt>
                <dd class="idx-name">{item.title}</dd>
              </div>
            ))
          }
        </dl>
        <p class="idx-note mono">La web, el SEO y el growth van con todo.</p>
      </nav>
    </div>
  </div>

  <!-- Bottom meta strip -->
  <div class="hero-foot">
    <div class="container hero-foot-in">
      <span class="hf-item mono">
        <span class="hf-dot" aria-hidden="true"></span>
        {siteConfig.tagline}
      </span>
      <span class="hf-item hf-coords mono">{siteConfig.geo.latitude}° N / {siteConfig.geo.longitude}° W</span>
      <span class="hf-item mono" aria-hidden="true">Scroll ↓</span>
    </div>
  </div>
</section>

<style>
  .hero {
    --y: var(--accent);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
    scroll-margin-top: var(--layout-header-height);
  }

  .mono {
    font-family: var(--font-mono);
  }

  /* ---- Radial bloom ---- */
  .hero-glow {
    position: absolute;
    top: -20%;
    left: -10%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--text) 5%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  /* ---- Top meta row ---- */
  .hero-header {
    margin-bottom: var(--space-2xl);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }

  .top-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .top-meta::before {
    content: "";
    width: 40px;
    height: 2px;
    background: var(--border);
  }

  .studio-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-xs);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .studio-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--y);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  .ext {
    transition: transform var(--transition-fast);
  }

  .studio-link:hover .ext {
    transform: translate(2px, -2px);
  }

  /* ---- Title ---- */
  .hero-title-block {
    margin-bottom: var(--space-2xl);
    animation: fadeInUp 0.9s var(--motion-ease-out) 0.1s both;
  }

  .hero-title {
    font-size: clamp(2.75rem, 9.5vw, 8.75rem);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .ht-b {
    display: block;
    font-weight: 800;
    text-transform: uppercase;
  }

  .title-bold {
    position: relative;
    padding-left: 1.25rem;
  }

  .bold-accent {
    position: absolute;
    left: 0;
    top: 0.15em;
    width: 8px;
    height: 0;
    background: var(--text);
    animation: accentGrow 0.7s var(--motion-ease-out) 0.5s forwards;
  }

  .ht-l {
    display: block;
    font-weight: 300;
    font-style: italic;
    font-size: 0.55em;
    line-height: 1.08;
    letter-spacing: -0.015em;
    padding-left: 1.25rem;
    transform: translateY(-6%);
  }

  /* ---- Marquee band ---- */
  .hero-marquee {
    border-top: 4px solid var(--border);
    border-bottom: 4px solid var(--border);
    padding: var(--space-lg) 0;
    margin-bottom: var(--space-3xl);
    overflow: hidden;
    background: var(--text);
    color: var(--bg);
    transform: rotate(-1.25deg) scale(1.03);
    box-shadow: 0 10px 30px rgb(0 0 0 / 10%);
    animation: fadeInUp 0.9s var(--motion-ease-out) 0.2s both;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
    will-change: transform;
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-right: var(--space-md);
    white-space: nowrap;
  }

  .mq-word {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mq-dot {
    font-size: 1.5rem;
    opacity: 0.5;
  }

  /* ---- Info + index ---- */
  .hero-bottom {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
    animation: fadeInUp 0.9s var(--motion-ease-out) 0.35s both;
  }

  @media (min-width: 960px) {
    .hero-bottom {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-4xl);
    }
  }

  .hero-desc {
    max-width: 52ch;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .cta-main {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 48px;
    padding: var(--space-md) var(--space-xl);
    background: var(--text);
    color: var(--bg);
    border: 3px solid var(--text);
    font-weight: 700;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .cta-main:hover {
    transform: translate(-5px, -5px);
    box-shadow: 9px 9px 0 var(--y);
  }

  .cta-main:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .cta-arrow {
    transition: transform var(--transition-fast);
  }

  .cta-main:hover .cta-arrow {
    transform: translateX(6px);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 48px;
    padding: var(--space-md) var(--space-lg);
    border: 2px dashed var(--border);
    font-weight: 600;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
    transition: all var(--transition-base);
  }

  .cta-ghost:hover {
    opacity: 1;
    border-style: solid;
    background: var(--text);
    color: var(--bg);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--border);
  }

  .cta-ghost:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
    opacity: 1;
  }

  .ghost-arrow {
    transition: transform var(--transition-base);
  }

  .cta-ghost:hover .ghost-arrow {
    transform: translate(4px, -4px);
  }

  /* ---- Index list ---- */
  .idx-caption {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .idx-caption::before {
    content: "";
    width: 40px;
    height: 2px;
    background: var(--border);
  }

  .idx-list {
    margin: 0;
    border-top: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: var(--bg);
    box-shadow: var(--shadow-brutal);
  }

  .idx-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-lg);
    border-bottom: 1px solid var(--border-light);
    transition: background-color var(--transition-fast);
  }

  .idx-row:last-of-type {
    border-bottom: 0;
  }

  .idx-row:hover {
    background: var(--bg-alt);
  }

  .idx-num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    border-right: 1px solid var(--border-light);
    padding: var(--space-md) var(--space-md);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .idx-row:hover .idx-num {
    background: var(--y);
    color: #111110;
  }

  .idx-name {
    align-self: center;
    margin: 0;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .idx-note {
    margin-top: var(--space-md);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  /* ---- Foot bar ---- */
  .hero-foot {
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    border-top: 2px solid var(--border);
    background: var(--bg);
  }

  .hero-foot-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  .hf-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .hf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--y);
    animation: blink 2.4s ease-in-out infinite;
  }

  /* ---- Responsive ---- */
  @media (max-width: 639px) {
    .hero-title {
      font-size: clamp(2.375rem, 12.5vw, 3.5rem);
    }

    .ht-l {
      font-size: 0.6em;
    }

    .title-bold,
    .ht-l {
      padding-left: 0.75rem;
    }

    .bold-accent {
      width: 4px;
    }

    .cta-main,
    .cta-ghost {
      width: 100%;
      justify-content: center;
    }

    .hero-foot-in {
      justify-content: center;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 700px) {
    .hf-coords {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .hero * {
      transition: none !important;
    }
  }
</style>
