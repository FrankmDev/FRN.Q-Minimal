---
import { portfolioLink } from "../data/site";
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container hero-container">
    <div class="hero-top">
      <a
        class="portfolio-link mono"
        href={portfolioLink.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={portfolioLink.title}
      >
        {portfolioLink.label} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <h1 class="hero-title" id="hero-title">
      <span class="hero-line">Ecommerce,</span>
      <span class="hero-line hero-line-bottom"><span class="hero-b2b">B2B</span><span class="hero-slash" aria-hidden="true">/</span><span>Sistemas</span></span>
    </h1>

    <div class="hero-bottom">
      <p class="hero-desc">
        Diseño y desarrollo soluciones digitales que conectan ventas, clientes y operación.
      </p>
      <div class="hero-actions">
        <a href="#contacto" class="hero-cta">
          <span>Plantear un proyecto</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="#proyectos" class="hero-work-link">
          <span>Ver casos</span>
          <span aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: min(860px, calc(100svh - var(--layout-header-height)));
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: clamp(var(--space-xl), 5vw, var(--space-4xl)) 0;
    border-bottom: 3px solid var(--border);
  }

  .hero::after {
    content: "";
    position: absolute;
    width: clamp(14rem, 29vw, 27rem);
    aspect-ratio: 1;
    right: -11%;
    top: 8%;
    border: clamp(2rem, 5vw, 5rem) solid var(--border);
    opacity: 0.035;
    transform: rotate(18deg);
    pointer-events: none;
  }

  .hero-container {
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-md);
    margin-bottom: clamp(var(--space-2xl), 6vw, var(--space-4xl));
  }

  .portfolio-link {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .portfolio-link {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-light);
    text-underline-offset: 5px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .portfolio-link:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .portfolio-link:focus-visible,
  .hero-cta:focus-visible,
  .hero-work-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  .hero-title {
    position: relative;
    width: fit-content;
    max-width: 100%;
    font-size: clamp(3.35rem, 11.2vw, 10rem);
    line-height: 0.84;
    letter-spacing: -0.085em;
    font-weight: 800;
    text-transform: uppercase;
    animation: fadeInUp 0.8s var(--motion-ease-out) both;
  }

  .hero-line {
    display: block;
    white-space: nowrap;
  }

  .hero-line-bottom {
    display: flex;
    align-items: center;
    gap: 0.12em;
    margin-top: 0.1em;
    padding-left: 0.52em;
  }

  .hero-b2b {
    padding: 0.04em 0.12em 0.1em;
    background: var(--accent);
    box-shadow: 0.08em 0.08em 0 var(--border);
  }

  .hero-slash {
    font-family: var(--font-mono);
    font-size: 0.58em;
    font-weight: 400;
    letter-spacing: -0.12em;
    transform: rotate(9deg);
  }

  .hero-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-2xl);
    margin-top: clamp(var(--space-2xl), 6vw, var(--space-4xl));
    padding-left: 0.52em;
    animation: fadeInUp 0.8s var(--motion-ease-out) 120ms both;
  }

  .hero-desc {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-lg);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 3.5rem;
    padding: var(--space-md) var(--space-lg);
    border: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    box-shadow: 7px 7px 0 var(--accent);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .hero-cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 11px 11px 0 var(--accent);
  }

  .hero-cta span:last-child,
  .hero-work-link span:last-child {
    transition: transform var(--transition-fast);
  }

  .hero-cta:hover span:last-child {
    transform: translateX(4px);
  }

  .hero-work-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 3rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-work-link:hover span:last-child {
    transform: translate(3px, 3px);
  }

  @media (max-width: 720px) {
    .hero {
      min-height: unset;
      padding: var(--space-2xl) 0 var(--space-3xl);
    }

    .hero-top {
      margin-bottom: clamp(4rem, 17vw, 6rem);
    }

    .portfolio-link {
      font-size: 0.58rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .hero-title {
      font-size: clamp(2.55rem, 12.6vw, 5.2rem);
      line-height: 0.88;
      letter-spacing: -0.08em;
    }

    .hero-line-bottom {
      gap: 0.1em;
      padding-left: 0.2em;
    }

    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-xl);
      margin-top: var(--space-2xl);
      padding-left: 0;
    }

    .hero-desc {
      max-width: 32ch;
      font-size: 1rem;
    }

    .hero-actions {
      justify-content: flex-start;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 380px) {
    .hero-title {
      font-size: 12vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-bottom {
      animation: none;
    }
  }
</style>
