---
import { getImage } from "astro:assets";
import { siteConfig } from "../data/site";
import {
  getProjects,
  categoryLabels,
  casePath,
  type Project,
} from "../data/projects";

const projects = await getProjects();

const cases = await Promise.all(
  projects.map(async (project: Project) => ({
    slug: project.slug,
    title: project.title,
    href: casePath(project.slug),
    year: project.year,
    sector: project.sector,
    categoryLabel: categoryLabels[project.category],
    value: project.tagline,
    preview: (
      await getImage({
        src: project.cover.src,
        width: 880,
        format: "avif",
        quality: 58,
      })
    ).src,
  })),
);

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
   name: `Casos de ${siteConfig.name}`,
  description:
     `Casos de clientes y productos digitales desarrollados por ${siteConfig.name}.`,
  numberOfItems: cases.length,
  itemListElement: cases.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "CreativeWork",
      name: item.title,
      url: new URL(item.href, Astro.site).toString(),
      dateCreated: item.year,
      creator: {
        "@type": "Organization",
         name: siteConfig.name,
         url: siteConfig.url,
      },
    },
  })),
};
---

<section class="projects" id="proyectos" aria-labelledby="projects-title">
  <script
    type="application/ld+json"
    set:html={JSON.stringify(projectSchema)}
    slot="head"
  />

  <div class="section-accent" aria-hidden="true">
    <div class="accent-shape"></div>
  </div>

  <div class="container">
    <div class="section-header reveal">
      <div class="header-label">
        <span class="label-line" aria-hidden="true"></span>
        <span class="label-text">Casos de cliente</span>
      </div>
      <h2 class="section-title" id="projects-title">
        Resultados<br />
        <span class="title-highlight">antes que tecnología</span>
      </h2>
      <p class="section-intro">
        Cada caso explica el contexto, el problema y la decisión de negocio
        antes que el stack. La implementación es la evidencia, no el argumento.
      </p>
    </div>

     <div class="projects-list reveal" style="transition-delay: 150ms;" aria-label="Lista de casos">
      {
        cases.map((item, i) => (
          <a
            href={item.href}
            class="project-item"
            data-image={item.preview}
            data-index={i}
            aria-label={`Ver caso ${item.title}: ${item.value}`}
          >
            <div class="item-number" aria-hidden="true">
              <span>0{i + 1}</span>
            </div>

            <div class="item-content">
              <div class="item-meta">
                <span class="meta-year">{item.year}</span>
                <span class="meta-sep" aria-hidden="true">
                  /
                </span>
                <span class="meta-sector">{item.sector}</span>
              </div>
              <h3 class="item-title">{item.title}</h3>
              <p class="item-value">{item.value}</p>
            </div>

            <div class="item-highlight">
              <span class="highlight-dot" aria-hidden="true" />
              <span class="highlight-text">{item.categoryLabel}</span>
            </div>

            <div class="item-action" aria-hidden="true">
              <span class="action-icon">↗</span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="projects-footer">
      <a href="/casos/" class="footer-cta">
        <span>Ver todos los casos</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- Mockup flotante que sigue al cursor -->
  <div class="cursor-mockup" id="cursor-mockup" aria-hidden="true">
    <div class="mockup-chrome">
      <div class="chrome-dots">
        <span></span><span></span><span></span>
      </div>
      <div class="chrome-url"></div>
    </div>
    <div class="mockup-frame">
      <img
        alt="Vista previa del caso"
        class="mockup-img"
        id="mockup-img"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<script>
  // Only enable cursor mockup on devices that support hover
  const hoverQuery = window.matchMedia("(hover: hover)");

   function initCursorMockup() {
     if (!hoverQuery.matches || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const projectItems = document.querySelectorAll(".project-item");
    const cursorMockup = document.getElementById("cursor-mockup");
    const mockupImg = document.getElementById(
      "mockup-img",
    ) as HTMLImageElement | null;
    const projectsSection = document.querySelector(".projects");

    if (!cursorMockup || !mockupImg) return;

    let mouseX = 0,
      mouseY = 0;
    let mockupX = 0,
      mockupY = 0;
    let isHovering = false;
    let rafId: number | null = null;

    function lerp(start: number, end: number, factor: number) {
      return start + (end - start) * factor;
    }

    function updateMockupPosition() {
      if (!isHovering) {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
        return;
      }

      // Snappier mockup lerp
      mockupX = lerp(mockupX, mouseX, 0.15);
      mockupY = lerp(mockupY, mouseY, 0.15);

      // Offset to position mockup closer to cursor
      const offsetX = 30;
      const offsetY = -120;

      if (cursorMockup) {
        cursorMockup.style.transform = `translate3d(${mockupX + offsetX}px, ${mockupY + offsetY}px, 0)`;
      }

      rafId = requestAnimationFrame(updateMockupPosition) as unknown as number;
    }

    document.addEventListener(
      "mousemove",
      (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      },
      { passive: true },
    );

     projectItems.forEach((item) => {
      const imageUrl = item.getAttribute("data-image");

      const handleEnter = () => {
        if (imageUrl && mockupImg) {
          mockupImg.src = imageUrl;
          cursorMockup.classList.add("active");
          isHovering = true;

          if (!rafId) {
            rafId = requestAnimationFrame(updateMockupPosition);
          }
        }
      };

      const handleLeave = () => {
        cursorMockup.classList.remove("active");
        isHovering = false;
      };

      item.addEventListener("mouseenter", handleEnter);
      item.addEventListener("mouseleave", handleLeave);
    });

    // Safety: restore cursor if mouse leaves the entire section
    projectsSection?.addEventListener("mouseleave", () => {
      cursorMockup.classList.remove("active");
      isHovering = false;
    });
  }

  // Initialize
  initCursorMockup();

  // IntersectionObserver for project items entrance (slide from left)
  const itemObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const idx = parseInt(el.getAttribute("data-index") || "0");
          el.style.transitionDelay = `${idx * 60}ms`;
          el.classList.add("visible");
          itemObserver.unobserve(el);
        }
      });
    },
    { threshold: 0.05, rootMargin: "0px 0px -5% 0px" },
  );

  document.querySelectorAll(".project-item").forEach((item) => {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      itemObserver.observe(item);
    } else {
      item.classList.add("visible");
    }
  });
</script>

<style>
  .projects {
    position: relative;
    padding: var(--space-4xl) 0 calc(var(--space-4xl) + var(--space-2xl));
    min-height: 100vh;
  }

  .projects::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      var(--border) 0,
      var(--border) 20px,
      transparent 20px,
      transparent 40px
    );
  }

  .section-accent {
    position: absolute;
    top: var(--space-4xl);
    right: 5%;
    width: clamp(100px, 15vw, 200px);
    height: clamp(100px, 15vw, 200px);
    pointer-events: none;
    opacity: 0.05;
  }

  @media (max-width: 768px) {
    .section-accent {
      display: none;
    }
  }

  .accent-shape {
    width: 100%;
    height: 100%;
    border: clamp(20px, 4vw, 40px) solid var(--border);
    border-radius: 50%;
  }

  .section-header {
    margin-bottom: var(--space-3xl);
  }

  .header-label {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .label-line {
    width: 60px;
    height: 2px;
    background: var(--border);
  }

  .label-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .section-title {
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .title-highlight {
    font-weight: 800;
  }

  .section-intro {
    max-width: 60ch;
    margin-top: var(--space-lg);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--text-muted);
  }

  .projects-list {
    border-top: 4px solid var(--border);
  }

  .project-item {
    display: grid;
    grid-template-columns: 60px 1fr auto auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-2xl) 0;
    border-bottom: 4px solid var(--border);
    cursor: none;
    position: relative;
    text-decoration: none;
    color: inherit;
    /* Entrance animation defaults */
    opacity: 0;
    transform: translateX(-24px);
    transition:
      background var(--transition-base),
      padding var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base);
  }

  .project-item.visible {
    opacity: 1;
    transform: translateX(0);
    transition:
      background var(--transition-base),
      padding var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base),
      opacity 0.55s var(--motion-ease-out),
      transform 0.55s var(--motion-ease-out);
  }

  @media (hover: none), (pointer: coarse) {
    .project-item {
      cursor: pointer;
    }
  }

  /* Left accent bar on hover */
  .project-item::before {
    content: "";
    position: absolute;
    left: -4px;
    bottom: 0;
    width: 4px;
    height: 0;
    background: var(--text);
    transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-item:hover::before {
    height: 100%;
    top: 0;
    bottom: auto;
  }

  .project-item:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: -3px;
  }

  @media (max-width: 768px) {
    .project-item {
      grid-template-columns: 40px 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-sm) var(--space-md);
      padding: var(--space-xl) 0;
    }
  }

  @media (min-width: 769px) and (max-width: 1100px) {
    .project-item {
      grid-template-columns: 50px 1fr auto auto;
      gap: var(--space-sm);
    }
  }

  .project-item:hover {
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .project-item:hover .item-title {
    transform: translateX(var(--space-xs)) skewX(-2deg);
  }

  .project-item:hover .action-icon {
    transform: translate(6px, -6px) scale(1.1);
  }

  .item-number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    opacity: 0.3;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.8125rem;
    margin-bottom: var(--space-xs);
    opacity: 0.6;
    font-family: var(--font-mono);
  }

  .meta-sep {
    opacity: 0.5;
  }

  .item-title {
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    transition: transform var(--transition-base);
  }

  .item-value {
    max-width: 68ch;
    margin-top: var(--space-sm);
    font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
    line-height: 1.45;
    opacity: 0.7;
  }

  .item-highlight {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    border: 3px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 700;
    font-family: var(--font-mono);
    white-space: nowrap;
    transition: border-color var(--transition-base);
  }

  .project-item:hover .item-highlight {
    border-color: var(--bg);
  }

  @media (max-width: 768px) {
    .item-highlight {
      display: none;
    }
  }

  .highlight-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .item-action {
    width: 64px;
    height: 64px;
    border: 3px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .project-item:hover .item-action {
    background: var(--bg);
    color: var(--text);
    border-color: var(--bg);
    box-shadow: 6px 6px 0 var(--border-light);
  }

  @media (max-width: 768px) {
    .item-action {
      display: none;
    }
  }

  .action-icon {
    transition: transform var(--transition-base);
  }

  .projects-footer {
    margin-top: var(--space-2xl);
    text-align: center;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-2xl);
    font-weight: 800;
    font-size: 1.125rem;
    border: 4px solid var(--border);
    background: var(--bg);
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 8px 8px 0 var(--border);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      background var(--transition-fast);
  }

  .footer-cta:hover {
    background: var(--text);
    color: var(--bg);
    transform: translate(-6px, -6px);
    box-shadow: 14px 14px 0 var(--border-strong);
  }

  .footer-cta:focus-visible {
    outline: 4px solid var(--text);
    outline-offset: 4px;
  }

  /* Mockup que sigue al cursor - above custom cursor */
  .cursor-mockup {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 10000;
    opacity: 0;
    transform: translate3d(-100%, -100%, 0);
    transition: opacity 0.2s ease;
    will-change: transform;
    border: 4px solid var(--border);
    box-shadow: 12px 12px 0 var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    width: 440px;
  }

  .cursor-mockup.active {
    opacity: 1;
  }

  /* Mockup chrome bar */
  .mockup-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.5rem 0.75rem;
    background: var(--bg-alt);
    border-bottom: 2px solid var(--border);
    flex-shrink: 0;
  }

  .chrome-dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .chrome-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border);
    opacity: 0.5;
  }

  .chrome-dots span:nth-child(1) {
    opacity: 0.3;
  }
  .chrome-dots span:nth-child(2) {
    opacity: 0.5;
  }
  .chrome-dots span:nth-child(3) {
    opacity: 0.7;
  }

  .chrome-url {
    flex: 1;
    height: 16px;
    background: var(--border);
    opacity: 0.12;
    border-radius: 2px;
  }

  .mockup-frame {
    width: 440px;
    height: 260px;
    background: var(--bg);
    border-top: none;
    padding: 0;
    overflow: hidden;
    flex-shrink: 0;
  }

  .mockup-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-item:hover ~ .cursor-mockup .mockup-img {
    transform: scale(1.05); /* very subtle zoom when mockup appears */
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .project-item,
    .item-title,
    .action-icon,
    .footer-cta,
    .cursor-mockup {
      transition: none !important;
    }

    .project-item {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
