---
import { getImage } from "astro:assets";
import { siteConfig } from "../data/site";
import { getProjects, casePath, type Project } from "../data/projects";

const projects = (await getProjects())
  .filter((project: Project) => project.status === "live")
  .slice(0, 3);

const cases = await Promise.all(
  projects.map(async (project: Project) => ({
    slug: project.slug,
    title: project.title,
    href: casePath(project.slug),
    year: project.year,
    sector: project.sector,
    alt: project.cover.alt,
    preview: (
      await getImage({
        src: project.cover.src,
        width: 1000,
        format: "avif",
        quality: 62,
      })
    ).src,
  })),
);

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Casos seleccionados de ${siteConfig.name}`,
  description: `Casos de clientes y productos digitales desarrollados por ${siteConfig.name}.`,
  numberOfItems: cases.length,
  itemListElement: cases.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "CreativeWork",
      name: item.title,
      url: new URL(item.href, Astro.site).toString(),
      dateCreated: item.year,
      creator: {
        "@type": "Organization",
        name: siteConfig.name,
        url: siteConfig.url,
      },
    },
  })),
};
---

<section class="projects" id="proyectos" aria-labelledby="projects-title">
  <script
    type="application/ld+json"
    set:html={JSON.stringify(projectSchema)}
    slot="head"
  />

  <div class="container">
    <header class="projects-header reveal">
      <span class="projects-label mono"><span aria-hidden="true"></span>Selección de casos</span>
      <h2 id="projects-title">Trabajo<br /><span>en contexto.</span></h2>
    </header>

    <ol class="projects-list reveal" aria-label="Casos seleccionados">
      {
        cases.map((item, index) => (
          <li class="project-row">
            <a href={item.href} class="project-link">
              <span class="project-number mono" aria-hidden="true">0{index + 1}</span>
              <figure class="project-image">
                <img src={item.preview} alt={item.alt} loading="lazy" decoding="async" />
              </figure>
              <div class="project-copy">
                <p class="project-meta mono">
                  <span>{item.year}</span><span aria-hidden="true">/</span><span>{item.sector}</span>
                </p>
                <h3 class="project-title">{item.title}</h3>
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="projects-footer">
      <a href="/casos/" class="all-cases-link">
        <span>Todos los casos</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
    scroll-margin-top: var(--layout-header-height);
  }

  .projects::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .projects-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .projects-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 0 0 auto;
    margin-bottom: 0.25em;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .projects-label span {
    width: 1.75rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    background: var(--accent);
  }

  .projects-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5.7vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .projects-header h2 span { color: var(--text-muted); }

  .projects-list {
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--border);
    list-style: none;
  }

  .project-row { border-bottom: 3px solid var(--border); }

  .project-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.25rem minmax(15rem, 0.82fr) minmax(0, 1fr) 3rem;
    align-items: center;
    gap: clamp(var(--space-md), 2.5vw, var(--space-2xl));
    min-height: 13rem;
    padding: var(--space-lg) 0;
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base), background-color var(--transition-base), padding var(--transition-base);
  }

  .project-link::before {
    position: absolute;
    z-index: -1;
    inset: 0 calc(var(--layout-gutter) * -1);
    content: "";
    background: var(--text);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .project-link:hover,
  .project-link:focus-visible { color: var(--bg); }
  .project-link:hover::before,
  .project-link:focus-visible::before { opacity: 1; }

  .project-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 5px;
  }

  .project-number {
    align-self: start;
    padding-top: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.48;
  }

  .project-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin: 0;
    border: 2px solid var(--border);
    background: var(--bg-alt);
  }

  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--motion-ease-out);
  }

  .project-link:hover .project-image img,
  .project-link:focus-visible .project-image img { transform: scale(1.045); }
  .project-copy { min-width: 0; }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-md);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .project-title {
    margin: 0;
    font-size: clamp(1.8rem, 4.1vw, 4rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    transition: transform var(--transition-base);
  }

  .project-link:hover .project-title,
  .project-link:focus-visible .project-title { transform: translateX(5px); }

  .project-arrow {
    display: grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    font-size: 1.25rem;
    transition: transform var(--transition-base), background-color var(--transition-base), color var(--transition-base);
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    transform: translate(4px, -4px);
    background: var(--accent);
    color: var(--text);
  }

  .projects-footer { display: flex; justify-content: flex-end; margin-top: var(--space-xl); }

  .all-cases-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 3rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .all-cases-link span:last-child { transition: transform var(--transition-fast); }
  .all-cases-link:hover span:last-child { transform: translateX(4px); }

  .all-cases-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .project-link {
      grid-template-columns: 1.65rem minmax(0, 1fr) 2.5rem;
      gap: var(--space-md);
      min-height: 10rem;
    }

    .project-image { grid-column: 2; grid-row: 1 / 3; }
    .project-copy { grid-column: 2; grid-row: 3; padding: var(--space-xs) 0; }
    .project-number { grid-column: 1; grid-row: 1; }
    .project-arrow { grid-column: 3; grid-row: 3; width: 2.5rem; }
    .project-title { font-size: clamp(1.75rem, 5vw, 3rem); }
  }

  @media (max-width: 760px) {
    .projects-header { display: block; }
    .projects-header h2 {
      margin-top: var(--space-lg);
      font-size: clamp(2.35rem, 9vw, 4.25rem);
      line-height: 0.9;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .project-link { grid-template-columns: 1fr 2.5rem; gap: var(--space-sm) var(--space-md); padding: var(--space-md) 0; }
    .project-image { grid-column: 1 / -1; grid-row: 1; }
    .project-number { display: none; }
    .project-copy { grid-column: 1; grid-row: 2; }
    .project-arrow { grid-column: 2; grid-row: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link, .project-image img, .project-title, .project-arrow, .all-cases-link span:last-child { transition: none; }
  }
</style>
