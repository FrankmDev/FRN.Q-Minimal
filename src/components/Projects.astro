---
import { getImage } from "astro:assets";
import { siteConfig } from "../data/site";
import { getFeaturedProjects, casePath, type Project } from "../data/projects";

const projects = await getFeaturedProjects();

// This historic preview still matches the published Fernando Feijoo case.
// Other archived previews belong to projects no longer published here.
const historicalMockups: Record<string, string> = {
  "fernando-feijoo": "/projects/fernando-feijoo.avif",
};

const cases = await Promise.all(
  projects.map(async (project: Project) => ({
    slug: project.slug,
    title: project.title,
    href: casePath(project.slug),
    year: project.year,
    sector: project.sector,
    alt: project.cover.alt,
    host: project.url
      ? new URL(project.url).hostname.replace(/^www\./, "")
      : null,
    preview: (
      await getImage({
        src: project.cover.src,
        width: 1000,
        format: "avif",
        quality: 62,
      })
    ).src,
  })),
);

---

<section class="projects" id="proyectos" aria-labelledby="projects-title">
  <span class="section-tag">Selección de casos</span>
  <div class="container">
    <header class="projects-header reveal">
      <h2 id="projects-title" class="section-title">Trabajo<br /><span class="title-mark">en contexto.</span></h2>
    </header>

    <ol class="projects-list reveal" aria-label="Casos seleccionados">
      {
        cases.map((item, index) => (
          <li class="project-row">
            <a
              href={item.href}
              class="project-link"
              data-image={historicalMockups[item.slug] ?? item.preview}
              data-host={item.host ?? siteConfig.name}
            >
              <span class="project-number mono" aria-hidden="true">0{index + 1}</span>
              <figure class="project-image">
                <img src={item.preview} alt={item.alt} loading="lazy" decoding="async" />
              </figure>
              <div class="project-copy">
                <p class="project-meta mono">
                  <span>{item.year}</span><span aria-hidden="true">/</span><span>{item.sector}</span>
                </p>
                <h3 class="project-title">{item.title}</h3>
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="projects-footer">
      <a href="/casos/" class="all-cases-link">
        <span>Todos los casos</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!-- Mockup flotante que sigue al cursor -->
  <div class="cursor-mockup" id="cursor-mockup" aria-hidden="true">
    <div class="mockup-chrome">
      <div class="chrome-dots">
        <span></span><span></span><span></span>
      </div>
      <span class="chrome-url mono" id="mockup-url"></span>
    </div>
    <div class="mockup-frame">
      <img
        alt=""
        class="mockup-img"
        id="mockup-img"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<script>
  const hoverQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
  const reducedQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  function initCursorMockup() {
    const section = document.querySelector<HTMLElement>(".projects");
    const mockup = document.getElementById("cursor-mockup");
    const mockupImg = document.getElementById("mockup-img") as HTMLImageElement | null;
    const urlLabel = document.getElementById("mockup-url");
    if (!section || !mockup || !mockupImg || !urlLabel) return;

    const stop = () => {
      mockup.classList.remove("active");
      section.classList.remove("mockup-ready");
    };

    if (!hoverQuery.matches || reducedQuery.matches || window.innerWidth <= 768) {
      stop();
      return;
    }
    section.classList.add("mockup-ready");

    let mouseX = 0;
    let mouseY = 0;
    let mockupX = 0;
    let mockupY = 0;
    let isHovering = false;
    let activeCopy: HTMLElement | null = null;
    let rafId: number | null = null;

    const lerp = (start: number, end: number, factor: number) =>
      start + (end - start) * factor;

    const updatePosition = () => {
      if (!isHovering) {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
        return;
      }

      mockupX = lerp(mockupX, mouseX, 0.15);
      mockupY = lerp(mockupY, mouseY, 0.15);

      const mockupRect = mockup.getBoundingClientRect();
      const copyRect = activeCopy?.getBoundingClientRect();
      let x = mockupX + 30;
      let y = mockupY - 120;

      // Keep the floating window beside, rather than over, the active title.
      if (copyRect && x + mockupRect.width > copyRect.left) {
        x = copyRect.left - mockupRect.width - 20;
      }
      x = Math.max(12, Math.min(x, window.innerWidth - mockupRect.width - 12));
      y = Math.max(12, Math.min(y, window.innerHeight - mockupRect.height - 12));

      mockup.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      rafId = requestAnimationFrame(updatePosition);
    };

    document.addEventListener(
      "mousemove",
      (event) => {
        mouseX = event.clientX;
        mouseY = event.clientY;
      },
      { passive: true },
    );

    section.querySelectorAll<HTMLElement>(".project-link").forEach((item) => {
      const imageUrl = item.dataset.image;
      const host = item.dataset.host ?? "";

      item.addEventListener("mouseenter", () => {
        if (!imageUrl) return;
        activeCopy = item.querySelector<HTMLElement>(".project-copy");
        if (mockupImg.getAttribute("src") !== imageUrl) {
          mockupImg.src = imageUrl;
        }
        urlLabel.textContent = host;
        mockup.classList.add("active");
        isHovering = true;
        if (!rafId) rafId = requestAnimationFrame(updatePosition);
      });

      item.addEventListener("mouseleave", () => {
        mockup.classList.remove("active");
        isHovering = false;
        activeCopy = null;
      });
    });

    section.addEventListener("mouseleave", () => {
      mockup.classList.remove("active");
      isHovering = false;
    });
  }

  initCursorMockup();
  hoverQuery.addEventListener("change", initCursorMockup);
  reducedQuery.addEventListener("change", initCursorMockup);
  window.addEventListener("resize", initCursorMockup);
</script>

<style>
  .projects {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
    scroll-margin-top: var(--layout-header-height);
  }

  .projects::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .projects-header {
    display: flex;
    align-items: end;
    justify-content: flex-end;
    gap: var(--space-xl);
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .projects-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5.7vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .projects-list {
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--border);
    list-style: none;
  }

  .project-row { border-bottom: 3px solid var(--border); }

  .project-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.25rem minmax(15rem, 0.82fr) minmax(0, 1fr) 3rem;
    align-items: center;
    gap: clamp(var(--space-md), 2.5vw, var(--space-2xl));
    min-height: 13rem;
    padding: var(--space-lg) 0;
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base), background-color var(--transition-base), padding var(--transition-base);
  }

  .project-link::before {
    position: absolute;
    z-index: -1;
    inset: 0 calc(var(--layout-gutter) * -1);
    content: "";
    background: var(--text);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .project-link:hover,
  .project-link:focus-visible { color: var(--bg); }
  .project-link:hover::before,
  .project-link:focus-visible::before { opacity: 1; }

  .project-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 5px;
  }

  .project-number {
    align-self: start;
    padding-top: var(--space-sm);
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0.48;
  }

  .project-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin: 0;
    border: 2px solid var(--border);
    background: var(--bg-alt);
  }

  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--motion-ease-out);
  }

  .project-link:hover .project-image img,
  .project-link:focus-visible .project-image img { transform: scale(1.045); }
  .project-copy { min-width: 0; }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-md);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .project-title {
    margin: 0;
    font-size: clamp(1.8rem, 4.1vw, 4rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    transition: transform var(--transition-base);
  }

  .project-link:hover .project-title,
  .project-link:focus-visible .project-title { transform: translateX(-0.75rem); }

  .project-arrow {
    display: grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid currentColor;
    font-size: 1.25rem;
    transition: transform var(--transition-base), background-color var(--transition-base), color var(--transition-base);
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    transform: translate(4px, -4px);
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .projects-footer { display: flex; justify-content: flex-end; margin-top: var(--space-xl); }

  /* ---- Mockup flotante que sigue al cursor ---- */
  .cursor-mockup {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    width: 440px;
    overflow: hidden;
    border: 4px solid var(--border);
    background: var(--bg);
    box-shadow: 12px 12px 0 var(--border);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-100%, -100%, 0);
    transition: opacity 0.2s ease;
    will-change: transform;
  }

  .cursor-mockup.active { opacity: 1; }

  .mockup-chrome {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--border);
    background: var(--bg-alt);
  }

  .chrome-dots {
    display: flex;
    flex-shrink: 0;
    gap: 5px;
  }

  .chrome-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border);
    opacity: 0.5;
  }

  .chrome-dots span:nth-child(1) { opacity: 0.3; }
  .chrome-dots span:nth-child(3) { opacity: 0.7; }

  .chrome-url {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .mockup-frame {
    flex: 1;
    min-height: 0;
    height: 260px;
    overflow: hidden;
  }

  .mockup-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .cursor-mockup { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-mockup { display: none; }
  }


  .all-cases-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 3rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .all-cases-link span:last-child { transition: transform var(--transition-fast); }
  .all-cases-link:hover span:last-child { transform: translateX(4px); }

  .all-cases-link:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .project-link {
      grid-template-columns: 1.65rem minmax(0, 1fr) 2.5rem;
      gap: var(--space-md);
      min-height: 10rem;
    }

    .project-image { grid-column: 2; grid-row: 1 / 3; }
    .project-copy { grid-column: 2; grid-row: 3; padding: var(--space-xs) 0; }
    .project-number { grid-column: 1; grid-row: 1; }
    .project-arrow { grid-column: 3; grid-row: 3; width: 2.5rem; }
    .project-title { font-size: clamp(1.75rem, 5vw, 3rem); }
  }

  @media (max-width: 760px) {
    .projects-header { display: block; }
    .projects-header h2 {
      font-size: clamp(2.35rem, 9vw, 4.25rem);
      line-height: 0.9;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .project-link { grid-template-columns: 1fr 2.5rem; gap: var(--space-sm) var(--space-md); padding: var(--space-md) 0; }
    .project-image { grid-column: 1 / -1; grid-row: 1; }
    .project-number { display: none; }
    .project-copy { grid-column: 1; grid-row: 2; }
    .project-arrow { grid-column: 2; grid-row: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link, .project-image, .project-image img, .project-title, .project-arrow, .all-cases-link span:last-child { transition: none; }
  }
</style>
