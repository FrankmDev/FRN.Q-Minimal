---
import { Image } from "astro:assets";
import { agencyCollaboration } from "../data/agency-collaboration";
import {
  casePath,
  getPublishedProjects,
  statusLabels,
} from "../data/projects";

const projectOrder = ["kingbelt", "emilio-faraoni", "grn-urban"];
const publishedProjects = await getPublishedProjects();
const projects = projectOrder
  .map((slug) => publishedProjects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
const collaborationHref = `/?tipo=${agencyCollaboration.contactType}#contacto`;
---

<main id="main-content" class="agency-page">
  <section class="agency-hero" aria-labelledby="agency-title">
    <div class="container">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Colaboraciones</span>
      </nav>
      <div class="hero-grid">
        <div>
          <p class="section-tag section-tag--inline">Colaboración técnica · 01</p>
          <h1 id="agency-title">{agencyCollaboration.title}</h1>
          <p class="hero-subtitle">{agencyCollaboration.description}</p>
        </div>
        <div class="hero-note">
          <span class="mono">FRN.Q / PARTNER MODE</span>
          <p>Una práctica independiente para estudios, agencias y equipos que necesitan ejecución técnica especializada.</p>
          <a class="text-link" href={collaborationHref} data-track="cta_click" data-track-location="agency_hero" data-track-label="Proponer colaboración">
            Proponer colaboración <span aria-hidden="true">↘</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="capabilities" aria-labelledby="capabilities-title">
    <div class="container capabilities-panel">
      <div class="capabilities-heading">
        <span class="mono">01 — CAPACIDAD TÉCNICA</span>
        <h2 id="capabilities-title">Producción web, <span>de interfaz a sistema.</span></h2>
        <p>Entro en el alcance que necesita desarrollo especializado y lo coordino contigo.</p>
      </div>
      <ol class="capability-list">
        {agencyCollaboration.capabilities.map((item) => (
          <li>
            <span class="capability-number mono">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ways container" aria-labelledby="ways-title">
    <header class="section-heading">
      <span class="mono">02 — MODELO DE TRABAJO</span>
      <h2 id="ways-title">Me adapto al acuerdo. <span>No al revés.</span></h2>
    </header>
    <ol class="ways-list">
      {agencyCollaboration.collaborationModes.map((mode) => (
        <li>
          <span class="way-index mono">{mode.number}</span>
          <div><h3>{mode.title}</h3><p>{mode.detail}</p></div>
          <span class="way-arrow" aria-hidden="true">↗</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="working" aria-labelledby="working-title">
    <div class="container working-grid">
      <div class="working-heading">
        <span class="mono">03 — FORMA DE COLABORAR</span>
        <h2 id="working-title">Previsible para tu equipo. <span>Clara para tu cliente.</span></h2>
      </div>
      <div class="working-column">
        <h3>Qué puedes esperar</h3>
        <ul>
          {agencyCollaboration.delivery.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="working-column relationship-column">
        <h3>Cómo cuidamos la relación</h3>
        <p>La relación con tu cliente se protege con condiciones acordadas por escrito antes de empezar:</p>
        <ul>
          {agencyCollaboration.relationship.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="work container" aria-labelledby="work-title">
    <header class="work-heading">
      <div><span class="mono">04 — TRABAJO PUBLICADO</span><h2 id="work-title">Proyectos reales. <span>Estado a la vista.</span></h2></div>
      <a class="text-link" href="/casos/">Ver todos los casos <span aria-hidden="true">→</span></a>
    </header>
    <ol class="work-list">
      {projects.map((project, index) => (
        <li>
          <div class="work-link">
            <span class="work-number mono">{String(index + 1).padStart(2, "0")}</span>
            <a class="case-link" href={casePath(project.slug)} data-track="case_click" data-track-location="agency" data-track-slug={project.slug}>
              <span class="work-image">
                <Image src={project.cover.src} alt={project.cover.alt} widths={[480, 800]} sizes="(max-width: 760px) 36vw, 16rem" format="avif" quality={82} loading="lazy" />
              </span>
              <span class="work-copy">
                <span class="mono work-status">{statusLabels[project.status]}</span>
                <strong>{project.title}</strong>
                <span>{project.tagline}</span>
                <span class="case-detail">Leer el caso →</span>
              </span>
            </a>
            {project.url && <a class="external-project mono" href={project.url} target="_blank" rel="noopener noreferrer">{project.urlLabel} ↗</a>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="start" aria-labelledby="start-title">
    <div class="container start-inner">
      <div class="start-heading">
        <span class="mono">05 — PRIMER PASO</span>
        <h2 id="start-title">Empezamos por <span>el briefing.</span></h2>
      </div>
      <ol class="start-process">
        {agencyCollaboration.process.map((step) => (
          <li><span class="mono">{step.number}</span><div><h3>{step.title}</h3><p>{step.detail}</p></div></li>
        ))}
      </ol>
      <a class="proposal-cta" href={collaborationHref} data-track="cta_click" data-track-location="agency_close" data-track-label="Proponer colaboración">
        <span>Proponer colaboración</span><span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</main>

<style>
  .agency-page { padding-top: var(--layout-header-height); }
  .mono { font-family: var(--font-mono); }
  .agency-hero { padding: var(--space-xl) 0 clamp(var(--space-3xl), 8vw, 8rem); }
  .crumbs { display: flex; gap: var(--space-sm); margin-bottom: clamp(var(--space-2xl), 6vw, 5rem); font: 700 0.6875rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .crumbs a { color: var(--text-muted); }
  .crumbs [aria-current="page"] { color: var(--text); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr); align-items: end; gap: var(--space-3xl); }
  .section-tag--inline { position: static; display: inline-flex; margin-bottom: var(--space-xl); }
  .agency-hero h1 { max-width: 13ch; margin: 0; font-size: clamp(3.4rem, 8.5vw, 8.2rem); font-weight: 800; line-height: 0.88; letter-spacing: -0.08em; overflow-wrap: anywhere; }
  .hero-subtitle { max-width: 36ch; margin: var(--space-xl) 0 0; font-size: clamp(1.125rem, 2vw, 1.5rem); font-weight: 600; line-height: 1.4; }
  .hero-note { padding: var(--space-lg) 0 0 var(--space-lg); border-top: 3px solid var(--border); border-left: 1px solid var(--border-light); }
  .hero-note > span, .capabilities-heading > span, .section-heading > span, .working-heading > span, .work-heading .mono, .start-heading > span { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; }
  .hero-note p { max-width: 32ch; margin: var(--space-lg) 0; line-height: 1.6; }
  .text-link { display: inline-flex; align-items: center; gap: var(--space-md); border-bottom: 2px solid var(--accent); padding: var(--space-xs) 0; font-size: 0.8125rem; font-weight: 800; }
  .text-link:focus-visible, .case-link:focus-visible, .external-project:focus-visible, .proposal-cta:focus-visible { outline: 3px solid var(--text); outline-offset: 4px; }
  .capabilities { padding: 0 0 clamp(var(--space-3xl), 8vw, 8rem); }
  .capabilities-panel { display: grid; grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); gap: clamp(var(--space-xl), 6vw, 6rem); padding: clamp(var(--space-lg), 4vw, var(--space-3xl)); border: 3px solid var(--border); border-top: 6px solid var(--accent); background: var(--text); color: var(--bg); box-shadow: 12px 12px 0 var(--border); }
  .capabilities-heading > span { color: var(--accent); }
  .capabilities-heading h2, .section-heading h2, .working-heading h2, .work-heading h2, .start-heading h2 { margin: var(--space-xl) 0 0; font-size: clamp(2rem, 4.4vw, 4.4rem); font-weight: 800; line-height: 0.94; letter-spacing: -0.07em; }
  .capabilities-heading h2 span, .section-heading h2 span, .working-heading h2 span, .work-heading h2 span, .start-heading h2 span { color: var(--accent); }
  .capabilities-heading p { max-width: 34ch; margin-top: var(--space-lg); color: var(--bg); line-height: 1.55; }
  .capability-list { margin: 0; padding: 0; list-style: none; }
  .capability-list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: var(--space-md); padding: var(--space-md) 0; border-top: 1px solid var(--border-light); }
  .capability-number { grid-row: span 2; color: var(--accent); font-size: 0.75rem; font-weight: 700; }
  .capability-list h3 { margin: 0; font-size: clamp(1rem, 1.8vw, 1.375rem); font-weight: 800; }
  .capability-list p { margin: var(--space-xs) 0 0; color: var(--bg); font-size: 0.8125rem; line-height: 1.5; }
  .ways { padding-bottom: clamp(var(--space-3xl), 8vw, 8rem); }
  .section-heading { display: grid; grid-template-columns: 0.65fr 1.35fr; align-items: start; gap: var(--space-xl); padding-bottom: var(--space-xl); border-bottom: 3px solid var(--border); }
  .section-heading > span, .working-heading > span, .work-heading .mono, .start-heading > span { color: var(--text-muted); }
  .section-heading h2 { max-width: 16ch; margin: 0; font-size: clamp(2.25rem, 5vw, 5rem); }
  .section-heading h2 span, .work-heading h2 span { color: var(--text-muted); }
  .ways-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .ways-list li { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) 1rem; gap: var(--space-md); min-height: 11rem; padding: var(--space-xl) var(--space-lg) var(--space-lg) 0; border-bottom: 1px solid var(--border-light); }
  .ways-list li + li { padding-left: var(--space-lg); border-left: 1px solid var(--border-light); }
  .way-index { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; }
  .ways-list h3 { margin: 0 0 var(--space-sm); font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 800; letter-spacing: -0.04em; }
  .ways-list p { max-width: 32ch; margin: 0; color: var(--text-secondary); font-size: 0.875rem; line-height: 1.55; }
  .way-arrow { color: var(--text-muted); }
  .working { padding: clamp(var(--space-3xl), 7vw, 7rem) 0; border-block: 3px solid var(--border); background: var(--bg-alt); }
  .working-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.8fr) minmax(14rem, 0.8fr); gap: var(--space-2xl); align-items: start; }
  .working-heading h2 { max-width: 12ch; font-size: clamp(2rem, 4.2vw, 4rem); }
  .working-heading h2 span { color: var(--text-muted); }
  .working-column { padding-top: var(--space-lg); border-top: 3px solid var(--border); }
  .working-column h3 { margin: 0 0 var(--space-lg); font-size: 1.125rem; font-weight: 800; }
  .working-column p, .working-column li { color: var(--text-secondary); font-size: 0.875rem; line-height: 1.55; }
  .working-column p { margin: 0 0 var(--space-md); }
  .working-column ul { display: grid; gap: var(--space-md); margin: 0; padding: 0; list-style: none; }
  .working-column li { position: relative; padding-left: var(--space-lg); }
  .working-column li::before { position: absolute; left: 0; content: "—"; color: var(--text); font-family: var(--font-mono); }
  .relationship-column { border-top-color: var(--accent); }
  .work { padding-block: clamp(var(--space-3xl), 8vw, 8rem); }
  .work-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-xl); padding-bottom: var(--space-xl); border-bottom: 3px solid var(--border); }
  .work-heading h2 { max-width: 13ch; font-size: clamp(2.25rem, 5vw, 5rem); }
  .work-heading .text-link { flex: 0 0 auto; }
  .work-list { margin: 0; padding: 0; list-style: none; }
  .work-list li { border-bottom: 1px solid var(--border-light); }
  .work-link { display: grid; grid-template-columns: 2rem minmax(0, 1fr) minmax(7rem, auto); align-items: center; gap: clamp(var(--space-md), 3vw, var(--space-2xl)); padding: var(--space-lg) 0; }
  .case-link { display: grid; grid-template-columns: minmax(7rem, 0.45fr) minmax(0, 1fr); align-items: center; gap: clamp(var(--space-md), 3vw, var(--space-2xl)); }
  .work-number { align-self: start; padding-top: var(--space-xs); color: var(--text-muted); font-size: 0.75rem; }
  .work-image { display: block; aspect-ratio: 16 / 10; overflow: hidden; border: 2px solid var(--border); background: var(--bg-alt); }
  .work-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .work-copy { display: grid; justify-items: start; gap: var(--space-xs); }
  .work-status { font-size: 0.625rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .work-copy strong { font-size: clamp(1.5rem, 3.2vw, 3rem); font-weight: 800; letter-spacing: -0.06em; line-height: 1; }
  .work-copy > span:not(.work-status) { max-width: 58ch; color: var(--text-secondary); font-size: 0.8125rem; line-height: 1.45; }
  .work-copy .case-detail { margin-top: var(--space-xs); color: var(--text); font-family: var(--font-mono); font-weight: 700; }
  .external-project { justify-self: end; color: var(--text); font-size: 0.6875rem; font-weight: 700; text-align: right; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .start { padding: clamp(var(--space-3xl), 7vw, 7rem) 0; background: var(--text); color: var(--bg); }
  .start-inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-2xl) clamp(var(--space-xl), 7vw, 7rem); align-items: start; }
  .start-heading > span { color: var(--accent); }
  .start-heading h2 { max-width: 10ch; margin-top: var(--space-lg); font-size: clamp(2.5rem, 5.8vw, 5.5rem); }
  .start-process { display: grid; gap: var(--space-lg); margin: 0; padding: 0; list-style: none; }
  .start-process li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-md); padding-top: var(--space-md); border-top: 1px solid currentColor; }
  .start-process li > span { color: inherit; font-size: 0.75rem; font-weight: 700; }
  .start-process h3 { margin: 0 0 var(--space-sm); font-size: 1rem; font-weight: 800; }
  .start-process p { max-width: 48ch; margin: 0; color: var(--bg); font-size: 0.875rem; line-height: 1.5; }
  .proposal-cta { grid-column: 2; display: flex; justify-content: space-between; align-items: center; gap: var(--space-lg); width: min(100%, 28rem); padding: var(--space-md) var(--space-lg); border: 3px solid var(--accent); background: var(--accent); color: var(--text-on-accent); box-shadow: 8px 8px 0 var(--bg); font-size: 0.875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; transition: transform var(--transition-fast), box-shadow var(--transition-fast); }
  .proposal-cta:hover { transform: translate(-4px, -4px); box-shadow: 12px 12px 0 var(--bg); }
  .proposal-cta:focus-visible { outline-color: var(--bg); }
  .capabilities-heading > span, .capabilities-heading h2 span, .capability-number,
  .start-heading > span, .start-heading h2 span { color: var(--text-accent-inverse); }
  @media (max-width: 900px) {
    .hero-grid, .capabilities-panel, .working-grid, .start-inner { grid-template-columns: 1fr; }
    .hero-grid { gap: var(--space-2xl); }
    .hero-note { max-width: 34rem; }
    .capabilities-panel { gap: var(--space-2xl); }
    .working-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .working-heading { grid-column: 1 / -1; }
    .working-heading h2 { max-width: 18ch; }
    .proposal-cta { grid-column: 1; }
  }
  @media (max-width: 760px) {
    .section-heading { grid-template-columns: 1fr; gap: var(--space-md); }
    .ways-list { grid-template-columns: 1fr; }
    .ways-list li, .ways-list li + li { min-height: 0; padding: var(--space-lg) 0; border-left: 0; }
    .work-heading { align-items: flex-start; flex-direction: column; }
    .work-link { grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-md); }
    .case-link { gap: var(--space-md); }
    .external-project { grid-column: 2; justify-self: start; }
    .start-process { grid-template-columns: 1fr; gap: var(--space-lg); }
    .start-process li, .start-process li:first-child { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-md); padding: 0; border: 0; }
    .start-process li > span { margin: 0; }
    .start-process p { max-width: 38ch; }
  }
  @media (max-width: 560px) {
    .agency-hero h1 { font-size: clamp(3rem, 13vw, 4.8rem); }
    .capabilities-panel { box-shadow: 6px 6px 0 var(--border); }
    .working-grid { grid-template-columns: 1fr; }
    .working-heading { grid-column: auto; }
    .work-link { grid-template-columns: 1.5rem minmax(0, 1fr); align-items: start; }
    .case-link { grid-column: 2; grid-row: 1; grid-template-columns: 1fr; }
    .work-image { grid-column: 1; grid-row: 1; width: min(100%, 12rem); }
    .work-copy { grid-column: 1; grid-row: 2; }
    .work-number { grid-column: 1; grid-row: 1 / span 2; }
    .external-project { grid-column: 2; grid-row: 2; text-align: left; }
    .work-copy strong { font-size: clamp(1.5rem, 8vw, 2.25rem); }
    .proposal-cta { width: calc(100% - 8px); }
  }
  @media (max-width: 380px) {
    .agency-hero h1 { font-size: 2.8rem; }
    .work-link { gap: var(--space-sm); }
  }
  @media (prefers-reduced-motion: reduce) {
    .proposal-cta { transition: none; }
  }
</style>
