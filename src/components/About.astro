---
import { serviceAreas } from "../data/services";
import { aboutProcess, directAdvantages } from "../data/about";
---

<section class="about" id="sobre-mi" aria-labelledby="about-title">
  <span class="section-tag">Estudio</span>
  <div class="container">
    <div class="about-intro reveal">
      <div class="about-lead">
        <p class="about-role">Francisco Muñoz · Fundador y responsable directo</p>
        <h2 id="about-title">Del negocio.<br /><span class="title-mark">Al producto.</span></h2>
      </div>
      <div class="about-intro-bottom">
        <p class="about-bio">
          Soy Francisco Muñoz y dirijo FRN.Q, un estudio independiente en Granada. Me encargo del diseño y del desarrollo, y hablas conmigo durante todo el proyecto. Trabajo en remoto con empresas de España y otros países.
        </p>
        <p class="about-specialities">
          <span class="specialities-label">Especialidades</span>
          <span>{serviceAreas.map((service) => service.title).join(" · ")}</span>
        </p>
        <div class="about-actions">
          <a
            href="#contacto"
            class="about-cta"
            data-track="cta_click"
            data-track-location="about"
            data-track-label="Hablemos del proyecto"
          >
            <span>Hablemos del proyecto</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="agency-reference" href="/colaboraciones/agencias/">¿Trabajas en una agencia? Colaboraciones técnicas <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>

    <section class="about-direct reveal" aria-labelledby="about-direct-title">
      <header class="direct-head">
        <span class="direct-label">Trabajar directo</span>
        <h3 id="about-direct-title">Decisiones y ejecución en la misma persona.</h3>
      </header>
      <ul class="direct-list">
        {
          directAdvantages.map((item) => (
            <li>
              <span class="direct-num" aria-hidden="true">{item.num}</span>
              <div>
                <h4>{item.title}</h4>
                <p>{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="process-section reveal" aria-labelledby="process-title">
      <header class="process-heading">
        <div>
          <span class="process-label">Proceso</span>
          <h3 id="process-title">De la primera pregunta al lanzamiento.</h3>
        </div>
        <span class="process-count"><span class="process-total">04</span><span>FASES</span></span>
      </header>

      <ol class="process-list">
        {
          aboutProcess.map((step) => (
            <li class="process-item">
              <span class="process-num" aria-hidden="true">{step.num}</span>
              <div class="process-copy">
                <h4>{step.title}</h4>
                <p>{step.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
  }

  .about::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  /* ---- Intro: asymmetric editorial split. The eyebrow anchors the top-left,
     the display title closes the column bottom-left; the support column stacks
     prose, ruled specialities and the action row anchored at its bottom. ---- */
  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    align-items: stretch;
    gap: clamp(var(--space-xl), 5vw, var(--space-4xl));
    padding: clamp(var(--space-lg), 4vw, var(--space-3xl)) 0;
    border-top: 3px solid var(--border);
    border-bottom: 1px solid var(--border-light);
  }

  .about-lead {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .about-role {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about-role::before {
    content: "";
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .about-intro h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.8rem, 6.5vw, 6.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.08em;
  }

  .about-intro-bottom {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about-bio {
    max-width: 36ch;
    margin: 0;
    font-size: clamp(0.9375rem, 1.5vw, 1.125rem);
    font-weight: 600;
    line-height: 1.55;
  }

  /* Specialities: ruled metadata block, mono for scanability without the
     uppercase glue of a single joined line. */
  .about-specialities {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    max-width: 38ch;
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-light);
  }

  .about-specialities .specialities-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .about-specialities span:last-child {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: var(--text-secondary);
  }

  /* Action row: the hard CTA leads, the agency link is a secondary textual
     exit. Anchored to the bottom of the column so it sits opposite the title. */
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--space-xl);
    min-height: 3.25rem;
    padding: var(--space-sm) var(--space-md);
    border: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    box-shadow: 6px 6px 0 var(--accent);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .about-cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 var(--accent);
  }

  .about-cta:hover span:last-child { transform: translateX(4px); }
  .about-cta span:last-child { transition: transform var(--transition-fast); }

  .about-cta:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  .agency-reference {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: var(--border-light);
    text-underline-offset: 3px;
  }

  .agency-reference:hover { color: var(--text); text-decoration-color: var(--accent); }
  .agency-reference:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }

  /* ---- Direct collaboration advantages: quiet ruled band between the loud
     intro and the inverted process panel. Density contrast is deliberate. ---- */
  .about-direct {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-xl), 5vw, var(--space-4xl));
    margin-top: clamp(var(--space-3xl), 6vw, 6rem);
    padding-top: clamp(var(--space-lg), 3vw, var(--space-2xl));
    border-top: 3px solid var(--border);
  }

  .direct-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .direct-label::before {
    content: "";
    flex: 0 0 auto;
    width: 1.5rem;
    height: 0.45rem;
    border: 1px solid var(--border);
    background: var(--accent);
  }

  .direct-head h3 {
    max-width: 22ch;
    margin: var(--space-md) 0 0;
    font-size: clamp(1.4rem, 3vw, 2.5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .direct-list {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .direct-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 2px solid var(--border);
  }

  .direct-num {
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    opacity: 0.55;
  }

  .direct-list h4 {
    margin: 0 0 var(--space-xs);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .direct-list p {
    max-width: 52ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* ---- Process: inverted panel, the section's signature device. ---- */
  .process-section {
    position: relative;
    margin-top: clamp(var(--space-3xl), 7vw, 7rem);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    border: 3px solid var(--border);
    border-top: 4px solid var(--accent);
    background: var(--text);
    color: var(--bg);
    box-shadow: 10px 10px 0 var(--border);
  }

  .process-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-light);
  }

  .process-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-accent-inverse);
  }

  .process-label::before {
    content: "";
    flex: 0 0 auto;
    width: 1.5rem;
    height: 0.45rem;
    background: var(--accent);
  }

  .process-heading h3 {
    max-width: 18ch;
    margin: var(--space-md) 0 0;
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .process-count {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex: 0 0 auto;
    color: var(--bg);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .process-count span:last-child {
    color: var(--bg);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .process-count .process-total {
    color: var(--text-accent-inverse);
    font-size: inherit;
    letter-spacing: inherit;
  }

  .process-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .process-list::before {
    position: absolute;
    top: 1rem;
    right: 1rem;
    left: 1rem;
    height: 2px;
    content: "";
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .process-item {
    position: relative;
    min-height: 13rem;
    padding: 0 var(--space-lg);
    border-left: 1px solid var(--border-light);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .process-item:first-child { padding-left: 0; border-left: 0; }
  .process-item:last-child { padding-right: 0; }
  .process-item:hover { background: color-mix(in srgb, var(--bg) 5%, transparent); transform: translateY(-4px); }

  .process-num {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 2px solid var(--accent);
    background: var(--text);
    color: var(--text-accent-inverse);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .process-copy { padding-top: var(--space-lg); }

  .process-copy h4 {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .process-copy p {
    max-width: 27ch;
    margin: 0;
    color: var(--bg);
    opacity: 0.76;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .about-intro { grid-template-columns: 1fr; gap: var(--space-xl); }
    .about-lead { gap: var(--space-lg); }
    .about-intro h2 { font-size: clamp(2.65rem, 9vw, 4.5rem); }
    .about-direct { grid-template-columns: 1fr; gap: var(--space-xl); }
    .direct-head h3 { max-width: 26ch; }
    .process-heading h3 { font-size: clamp(1.75rem, 4.5vw, 2.5rem); }
    .process-list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-xl); }
    .process-list::before { display: none; }
    .process-item { min-height: 11rem; padding: 0 var(--space-md); border-left: 0; }
    .process-item:nth-child(even) { border-left: 1px solid var(--border-light); }
    .process-item:first-child, .process-item:nth-child(3) { padding-left: 0; }
    .process-item:nth-child(even) { padding-right: 0; }
    .process-item:nth-child(3), .process-item:nth-child(4) { padding-top: var(--space-md); border-top: 1px solid var(--border-light); }
  }

  @media (max-width: 560px) {
    .about-intro { padding-block: var(--space-xl); }
    .about-intro h2 { font-size: clamp(2.5rem, 11vw, 3.75rem); }
    .about-cta { width: 100%; justify-content: space-between; }
    .process-section { margin-top: var(--space-3xl); box-shadow: 6px 6px 0 var(--border); }
    .process-heading { align-items: flex-start; }
    .process-count { font-size: 1.125rem; }
    .process-list { grid-template-columns: 1fr; gap: var(--space-lg); margin-top: var(--space-xl); }
    .process-list::before { display: block; top: 1rem; bottom: 1rem; left: 1rem; right: auto; width: 2px; height: auto; }
    .process-item, .process-item:first-child, .process-item:nth-child(3), .process-item:nth-child(even), .process-item:nth-child(4) {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      min-height: 0;
      gap: var(--space-md);
      padding: 0;
      border: 0;
    }
    .process-item:nth-child(3), .process-item:nth-child(4) { padding-top: 0; border-top: 0; }
    .process-copy { padding-top: 0; }
    .process-copy h4 { margin-bottom: var(--space-xs); }
    .process-copy p { max-width: 38ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-cta, .about-cta span:last-child, .process-item { transition: none; }
  }
</style>
