---
const process = [
  {
    num: "01",
    title: "Descubrir y acotar",
    desc: "Analizo el negocio, sus procesos y objetivos para fijar un alcance claro.",
  },
  {
    num: "02",
    title: "Diseñar",
    desc: "Defino estructura y experiencia desde las necesidades del negocio.",
  },
  {
    num: "03",
    title: "Desarrollar",
    desc: "Construyo el producto e integro los sistemas necesarios.",
  },
  {
    num: "04",
    title: "Probar y lanzar",
    desc: "Pruebas, publicación y entrega documentada.",
  },
];
---

<section class="about" id="sobre-mi" aria-labelledby="about-title">
  <span class="section-tag">Estudio</span>
  <div class="container">
    <div class="about-intro reveal">
      <h2 id="about-title">Del negocio.<br /><span class="title-mark">Al producto.</span></h2>
      <div class="about-intro-bottom">
        <p>
          Soy Francisco Muñoz, profesional independiente en Granada. Trabajo directamente contigo: entiendo el problema, defino el alcance y llevo el proyecto del diseño al lanzamiento.
        </p>
        <a href="#contacto" class="about-cta">
          <span>Hablemos del proyecto</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <section class="process-section reveal" aria-labelledby="process-title">
      <header class="process-heading">
        <div>
          <span class="process-label mono"><span aria-hidden="true"></span>Proceso</span>
          <h3 id="process-title">De la primera pregunta al lanzamiento.</h3>
        </div>
        <span class="process-count mono"><span class="process-total">04</span><span>FASES</span></span>
      </header>

      <ol class="process-list">
        {
          process.map((step) => (
            <li class="process-item">
              <span class="process-num mono" aria-hidden="true">{step.num}</span>
              <div class="process-copy">
                <h4>{step.title}</h4>
                <p>{step.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
    scroll-margin-top: var(--layout-header-height);
  }

  .about::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    align-items: end;
    gap: clamp(var(--space-xl), 5vw, var(--space-4xl));
    padding: clamp(var(--space-lg), 4vw, var(--space-3xl)) 0;
    border-top: 3px solid var(--border);
    border-bottom: 1px solid var(--border-light);
  }

  .process-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .process-label span {
    width: 1.5rem;
    height: 0.45rem;
    border: 1px solid currentColor;
    background: var(--bg);
  }

  .about-intro h2 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.8rem, 6.5vw, 6.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.08em;
  }

  .about-intro-bottom {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-lg);
    padding-bottom: 0.25rem;
  }

  .about-intro-bottom p {
    max-width: 36ch;
    margin: 0;
    font-size: clamp(0.9375rem, 1.5vw, 1.125rem);
    font-weight: 600;
    line-height: 1.55;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--space-xl);
    min-height: 3.25rem;
    padding: var(--space-sm) var(--space-md);
    border: 3px solid var(--border);
    background: var(--text);
    color: var(--bg);
    box-shadow: 6px 6px 0 var(--accent);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .about-cta:hover {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 var(--accent);
  }

  .about-cta:hover span:last-child { transform: translateX(4px); }
  .about-cta span:last-child { transition: transform var(--transition-fast); }

  .about-cta:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }

  .process-section {
    position: relative;
    margin-top: clamp(var(--space-3xl), 7vw, 7rem);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    border: 3px solid var(--border);
    border-top: 4px solid var(--accent);
    background: var(--text);
    color: var(--bg);
    box-shadow: 10px 10px 0 var(--border);
  }

  .process-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-light);
  }

  .process-label { color: var(--accent); }
  .process-label span { background: var(--accent); }

  .process-heading h3 {
    max-width: 18ch;
    margin: var(--space-md) 0 0;
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .process-count {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    flex: 0 0 auto;
    color: var(--bg);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .process-count span {
    color: var(--bg);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .process-count .process-total {
    color: var(--accent);
    font-size: inherit;
    letter-spacing: inherit;
  }

  .process-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .process-list::before {
    position: absolute;
    top: 1rem;
    right: 1rem;
    left: 1rem;
    height: 2px;
    content: "";
    background: color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .process-item {
    position: relative;
    min-height: 13rem;
    padding: 0 var(--space-lg);
    border-left: 1px solid var(--border-light);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .process-item:first-child { padding-left: 0; border-left: 0; }
  .process-item:last-child { padding-right: 0; }
  .process-item:hover { background: color-mix(in srgb, var(--bg) 5%, transparent); transform: translateY(-4px); }

  .process-num {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 2px solid var(--accent);
    background: var(--text);
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .process-copy { padding-top: var(--space-lg); }

  .process-copy h4 {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .process-copy p {
    max-width: 27ch;
    margin: 0;
    color: var(--bg);
    opacity: 0.76;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .about-intro { grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.8fr); }
    .about-intro h2 { font-size: clamp(2.65rem, 7.5vw, 4.75rem); }
    .process-heading h3 { font-size: clamp(1.75rem, 4.5vw, 2.5rem); }
    .process-list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-xl); }
    .process-list::before { display: none; }
    .process-item { min-height: 11rem; padding: 0 var(--space-md); border-left: 0; }
    .process-item:nth-child(even) { border-left: 1px solid var(--border-light); }
    .process-item:first-child, .process-item:nth-child(3) { padding-left: 0; }
    .process-item:nth-child(even) { padding-right: 0; }
    .process-item:nth-child(3), .process-item:nth-child(4) { padding-top: var(--space-md); border-top: 1px solid var(--border-light); }
  }

  @media (max-width: 560px) {
    .about-intro { grid-template-columns: 1fr; gap: var(--space-xl); padding-block: var(--space-xl); }
    .about-intro h2 { font-size: clamp(2.75rem, 11vw, 4.25rem); }
    .about-intro-bottom { align-items: flex-start; }
    .about-cta { width: fit-content; }
    .process-section { margin-top: var(--space-3xl); box-shadow: 6px 6px 0 var(--border); }
    .process-heading { align-items: flex-start; }
    .process-count { font-size: 1.125rem; }
    .process-list { grid-template-columns: 1fr; gap: var(--space-lg); margin-top: var(--space-xl); }
    .process-list::before { display: block; top: 1rem; bottom: 1rem; left: 1rem; right: auto; width: 2px; height: auto; }
    .process-item, .process-item:first-child, .process-item:nth-child(3), .process-item:nth-child(even), .process-item:nth-child(4) {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      min-height: 0;
      gap: var(--space-md);
      padding: 0;
      border: 0;
    }
    .process-item:nth-child(3), .process-item:nth-child(4) { padding-top: 0; border-top: 0; }
    .process-copy { padding-top: 0; }
    .process-copy h4 { margin-bottom: var(--space-xs); }
    .process-copy p { max-width: 38ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-cta, .about-cta span:last-child, .process-item { transition: none; }
  }
</style>
