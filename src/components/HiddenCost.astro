---
const friction = [
  "Catálogo, stock y precios en fuentes separadas",
  "Pedidos que se copian entre canales",
  "Sistemas que no comparten datos",
];

const system = [
  "Catálogo conectado con la gestión",
  "Pedidos en un flujo compartido",
  "Integraciones entre las herramientas",
];
---

<section class="operation" id="operacion" aria-labelledby="operation-title">
  <div class="container">
    <header class="operation-header reveal">
      <span class="operation-label mono"><span aria-hidden="true"></span>Operación</span>
      <h2 id="operation-title">Menos fricción.<br /><span>Mejor conectada.</span></h2>
    </header>

    <div class="comparison reveal">
      <article class="comparison-side friction-side" aria-labelledby="friction-title">
        <span class="comparison-num mono" aria-hidden="true">01</span>
        <div class="comparison-body">
          <h3 id="friction-title">Fricción actual</h3>
          <ul>
            {friction.map((item) => <li><span aria-hidden="true">—</span>{item}</li>)}
          </ul>
        </div>
      </article>

      <article class="comparison-side system-side" aria-labelledby="system-title">
        <span class="comparison-num mono" aria-hidden="true">02</span>
        <div class="comparison-body">
          <h3 id="system-title">Sistema mejor resuelto</h3>
          <ul>
            {system.map((item) => <li><span aria-hidden="true">+</span>{item}</li>)}
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .operation {
    position: relative;
    padding: clamp(var(--space-3xl), 8vw, 8rem) 0;
    scroll-margin-top: var(--layout-header-height);
  }

  .operation::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--border) 0 18px, transparent 18px 36px);
  }

  .mono { font-family: var(--font-mono); }

  .operation-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-bottom: clamp(var(--space-2xl), 5vw, var(--space-4xl));
  }

  .operation-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 0 0 auto;
    margin-bottom: 0.25em;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .operation-label span {
    width: 1.75rem;
    height: 0.5rem;
    border: 1px solid var(--border);
    background: var(--accent);
  }

  .operation-header h2 {
    margin: 0;
    font-size: clamp(2rem, 5.7vw, 5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-align: right;
  }

  .operation-header h2 span { color: var(--text-muted); }

  .comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    align-items: stretch;
  }

  .comparison-side {
    position: relative;
    display: flex;
    min-height: 20rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    border: 3px solid var(--border);
    transition: transform 300ms var(--motion-ease-out), box-shadow 300ms var(--motion-ease-out);
  }

  .comparison-side:hover {
    transform: translate(-6px, -6px);
    box-shadow: 10px 10px 0 var(--border);
  }

  .friction-side { background: var(--bg); color: var(--text); }
  .system-side { background: var(--text); color: var(--bg); box-shadow: 9px 9px 0 var(--accent); }

  .comparison-num {
    align-self: flex-end;
    font-size: clamp(4.5rem, 10vw, 8.5rem);
    font-weight: 800;
    line-height: 0.72;
    letter-spacing: -0.12em;
    opacity: 0.18;
    transition: transform 350ms var(--motion-ease-out), color 350ms ease;
  }

  .system-side .comparison-num { color: var(--accent); opacity: 0.85; }
  .comparison-side:hover .comparison-num { transform: translate(-0.15em, 0.08em) rotate(-5deg); }
  .comparison-body { position: relative; z-index: 1; }

  .comparison-body h3 {
    width: fit-content;
    margin: 0 0 var(--space-lg);
    font-size: clamp(1.2rem, 2.4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .system-side h3 {
    padding: 0.1em 0.22em;
    background: var(--accent);
    color: var(--text);
    transform: rotate(-1deg);
  }

  .comparison-body ul {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .comparison-body li {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    max-width: 36ch;
    font-size: clamp(0.9rem, 1.35vw, 1.05rem);
    font-weight: 600;
    line-height: 1.4;
  }

  .comparison-body li span { flex: 0 0 1rem; font-family: var(--font-mono); font-weight: 700; opacity: 0.55; }
  .system-side li span { color: var(--accent); opacity: 1; }

  @media (max-width: 760px) {
    .operation-header { display: block; }
    .operation-header h2 { margin-top: var(--space-lg); text-align: left; }
    .comparison { gap: var(--space-md); }
    .comparison-side { min-height: 18rem; }
  }

  @media (max-width: 560px) {
    .comparison { grid-template-columns: 1fr; gap: var(--space-lg); }
    .comparison-side { min-height: 15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .comparison-side, .comparison-num { transition: none; }
  }
</style>
