---
import { navItems, headerCta } from "../data/navigation";
import { portfolioLink, siteConfig } from "../data/site";
const navLinks = navItems.map((item) => ({ ...item, href: `/${item.href}` }));
---

<header class="header" id="header" role="banner">
  <div class="header-accent" aria-hidden="true">
    <div class="accent-line"></div>
    <div class="accent-blocks">
      <span></span><span></span><span></span>
    </div>
  </div>

  <div class="container header-inner">
    <a href="/" class="logo" aria-label="{siteConfig.name} — Inicio">
      <div class="logo-icon" aria-hidden="true">
        <div class="icon-grid">
          <span></span><span></span>
          <span></span><span></span>
        </div>
      </div>
      <span class="logo-text">{siteConfig.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a href={link.href} class="nav-link">
            <span class="link-bracket" aria-hidden="true">[</span>
            <span class="link-text">{link.label}</span>
            <span class="link-bracket" aria-hidden="true">]</span>
          </a>
        ))
      }
      <a
        href={portfolioLink.href}
        class="nav-link nav-link-ext"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="link-bracket" aria-hidden="true">[</span>
        <span class="link-text">{portfolioLink.label}</span>
        <span class="link-bracket" aria-hidden="true">]</span>
      </a>
    </nav>

    <div class="header-actions">
      <a href={`/${headerCta.href}`} class="header-cta">
        <span class="cta-text">{headerCta.label}</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="toggle-line" aria-hidden="true"></span>
        <span class="toggle-line" aria-hidden="true"></span>
        <span class="sr-only">Menú</span>
      </button>
    </div>
  </div>

  <div class="header-progress" aria-hidden="true">
    <div class="progress-bar" id="progress-bar"></div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Navegación móvil" inert>
    <div class="container">
      {
        navLinks.map((link) => (
          <a href={link.href} class="mobile-link">
            <span class="ml-bracket" aria-hidden="true">[</span>
            {link.label}
          </a>
        ))
      }
      <a
        href={portfolioLink.href}
        class="mobile-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="ml-bracket" aria-hidden="true">[</span>
        {portfolioLink.label}
      </a>
      <a href={`/${headerCta.href}`} class="mobile-cta">
        <span>{headerCta.label}</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const header = document.getElementById("header");
  const progressBar = document.getElementById("progress-bar");

  function setMenuOpen(open: boolean) {
    menuButton?.setAttribute("aria-expanded", String(open));
    menuButton?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menuButton?.classList.toggle("is-active", open);
    mobileNav?.toggleAttribute("inert", !open);
    mobileNav?.classList.toggle("is-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  }

  menuButton?.addEventListener("click", () => {
    setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      menuButton.focus();
    }
  });

  const desktopQuery = window.matchMedia("(min-width: 900px)");
  desktopQuery.addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false);
  });

  // Scroll: progress bar + shrink state (throttled via rAF)
  let ticking = false;
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrollY = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = docHeight > 0 ? scrollY / docHeight : 0;

        if (progressBar) {
          progressBar.style.width = `${Math.min(scrolled * 100, 100)}%`;
        }
        header?.classList.toggle("is-scrolled", scrollY > 60);

        ticking = false;
      });
    },
    { passive: true },
  );
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-fixed, 300);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 3px solid var(--border);
    transition:
      background var(--transition-base),
      box-shadow var(--transition-base);
    will-change: transform;
  }

  .header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    box-shadow: 0 4px 24px rgb(0 0 0 / 8%);
  }

  /* Industrial top strip: line + offset blocks */
  .header-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    display: flex;
    pointer-events: none;
    z-index: 2;
  }

  .accent-line {
    flex: 1;
    background: var(--border);
  }

  .accent-blocks {
    display: flex;
  }

  .accent-blocks span {
    width: 40px;
    height: 4px;
    background: var(--border);
    margin-left: 4px;
  }

  .accent-blocks span:nth-child(2) {
    width: 60px;
  }

  .accent-blocks span:nth-child(3) {
    width: 30px;
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    transition: padding var(--transition-base);
  }

  .header.is-scrolled .header-inner {
    min-height: 64px;
  }

  /* ---- Logo badge ---- */
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--border);
    background: var(--bg);
    box-shadow: var(--shadow-brutal);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    position: relative;
  }

  .logo:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--border);
  }

  .logo:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .logo-icon {
    width: 22px;
    height: 22px;
    border: 2px solid var(--border);
    padding: 2px;
    flex-shrink: 0;
  }

  .icon-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    height: 100%;
  }

  .icon-grid span {
    background: var(--border);
  }

  .logo:hover .icon-grid {
    transform: rotate(45deg);
    transition: transform 0.35s var(--motion-ease-out);
  }

  .icon-grid {
    transition: transform 0.35s var(--motion-ease-out);
  }

  .logo-text {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* ---- Desktop nav ---- */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-xs) var(--space-sm);
    position: relative;
    border: 2px solid transparent;
    transition: all var(--transition-fast);
  }

  .link-bracket {
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-fast);
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .nav-link .link-bracket:last-child {
    transform: translateX(4px);
  }

  .nav-link:hover .link-bracket,
  .nav-link:focus .link-bracket {
    opacity: 0.5;
    transform: translateX(0);
    color: var(--bg);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    box-shadow: 4px 4px 0 var(--y);
    transform: translate(-2px, -2px);
  }

  .nav-link-ext .link-text {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }

  /* ---- Actions ---- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--text);
    color: var(--bg);
    border: 3px solid var(--text);
    box-shadow: 6px 6px 0 var(--y);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .header-cta:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--y);
  }

  .header-cta:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .cta-arrow {
    transition: transform var(--transition-base);
  }

  .header-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* ---- Hamburger ---- */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    border: 2px solid var(--border);
    background: var(--bg);
    padding: 12px;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .menu-toggle:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--border);
  }

  .menu-toggle:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .toggle-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text);
    transition: all var(--transition-base);
    transform-origin: center;
  }

  .menu-toggle.is-active .toggle-line:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle.is-active .toggle-line:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ---- Progress bar ---- */
  .header-progress {
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 3px;
    overflow: hidden;
    pointer-events: none;
  }

  .progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: var(--y);
    transition: width 0.1s linear;
    will-change: width;
  }

  /* ---- Mobile nav ---- */
  .mobile-nav {
    display: grid;
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    background: var(--bg);
    border-bottom: 0 solid var(--border);
    transition:
      max-height var(--transition-base),
      border-width var(--transition-fast),
      visibility var(--transition-base);
  }

  .mobile-nav.is-open {
    max-height: 460px;
    border-bottom-width: 3px;
    visibility: visible;
  }

  .mobile-nav .container {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-top: var(--space-md);
    padding-bottom: var(--space-lg);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: var(--space-md) 0;
    font-size: 1rem;
    font-weight: 700;
    font-family: var(--font-mono);
    border-bottom: 1px solid var(--border-light);
    opacity: 0;
    transform: translateX(-16px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      padding-left var(--transition-fast),
      color var(--transition-fast);
  }

  .mobile-nav.is-open .mobile-link {
    opacity: 0.85;
    transform: translateX(0);
  }

  .mobile-nav.is-open .mobile-link:nth-child(1) { transition-delay: 80ms; }
  .mobile-nav.is-open .mobile-link:nth-child(2) { transition-delay: 140ms; }
  .mobile-nav.is-open .mobile-link:nth-child(3) { transition-delay: 200ms; }
  .mobile-nav.is-open .mobile-link:nth-child(4) { transition-delay: 260ms; }
  .mobile-nav.is-open .mobile-link:nth-child(5) { transition-delay: 320ms; }

  .ml-bracket {
    opacity: 0;
    color: var(--text-muted);
    transition: opacity var(--transition-fast);
  }

  .mobile-link:hover,
  .mobile-link:focus {
    opacity: 1;
    padding-left: var(--space-sm);
  }

  .mobile-link:hover .ml-bracket,
  .mobile-link:focus .ml-bracket {
    opacity: 1;
  }

  .mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    font-weight: 700;
    font-size: 0.875rem;
    background: var(--text);
    color: var(--bg);
    border: 3px solid var(--border);
    box-shadow: 6px 6px 0 var(--y);
    text-transform: uppercase;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .mobile-cta:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--y);
  }

  .mobile-cta:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  @media (min-width: 900px) {
    :root {
      --layout-header-height: 88px;
    }

    .header-inner {
      min-height: 84px;
    }

    .desktop-nav {
      display: flex;
      gap: var(--space-sm);
    }

    .header-cta {
      display: flex;
    }

    .menu-toggle,
    .mobile-nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .logo,
    .header-cta,
    .menu-toggle,
    .mobile-nav,
    .mobile-link,
    .mobile-cta,
    .progress-bar {
      transition: none !important;
    }
  }
</style>
